<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect non-www tmf-fdn.org to www.texasmethodistfoundation.org
    RewriteCond %{HTTP_HOST} ^tmf-fdn\.org$ [NC]
    RewriteRule ^(.*)$ https://texasmethodistfoundation.org/$1 [R=301,L]

    # Redirect www.tmf-fdn.org to www.texasmethodistfoundation.org
    RewriteCond %{HTTP_HOST} ^www\.tmf-fdn\.org$ [NC]
    RewriteRule ^(.*)$ https://texasmethodistfoundation.org/$1 [R=301,L]

    # Send would-be 404 requests to Craft
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/(favicon\.ico|apple-touch-icon.*\.png)$ [NC]
    RewriteRule (.+) index.php?p=$1 [QSA,L]
</IfModule>
