{##
 # NEWS LANDING PAGE TEMPLATE
 #}

{% set newsArticles = craft.entries.section('news').all() %}

{# --------------------- PAGE HEADER -------------------- #}
{% include "_fields/pageHeader" with { 'entry': entry } %}

<section class="c-block">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 col-md-10 col-lg-9 col-xl-8">

				{% for entry in newsArticles %}
				<article class="position-relative row justify-content-between{% if not loop.first %} mt-5{% endif %} pt-5 border-top{% if loop.last %} mb-5 pb-5 border-bottom{% endif %}">
					<div class="col-12 col-md-4 col-xl-3 mb-4">
						{% if entry.thumbnail | length %}
							{% set img = entry.thumbnail.one %}
							{% set imgSrc = img.url() %}
							{% set imgAlt = img.alt %}
						{% else %}
							{% set imgSrc = '/dist/img/logo-mark.png' %}
							{% set imgAlt = 'placeholder' %}
						{% endif %}
						<img class="img-fluid" src="{{ imgSrc }}" alt="{{ imgAlt }}" />
					</div>

					<div class="col-12 col-md-7 col-xl-8">
						<p class="u-preheading">{{ entry.postDate|date }}</p>
						<h2 class="h3 c-news__card-heading">{{ entry.title }}</h2>
						{% if entry.summary != '' %}<p>{{ entry.summary }}</p>{% endif %}
						<p>
							{% if entry.textLink.getLink() %}
								{% include "_fields/button" with {
									'button': entry.textLink, 
									'color': 'secondary', 
									'style': 'pill stretched-link'
								} %}
							{% else %}
								<a class="btn btn-secondary btn-pill stretched-link" href="{{ entry.url }}">Read More</a>
							{% endif %}
						</p>
					</div>
				</article>
				{% endfor %}

			</div>
		</div>
	</div>
</section>
