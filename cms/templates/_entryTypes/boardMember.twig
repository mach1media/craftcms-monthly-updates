{##
 # BOARD MEMBER DETAIL PAGE
 #}
{#
<section class="position-relative">
	<div class="c-hero c-hero--general">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-12 col-md-5 text-center">
					<p class="u-preheading">{{ entry.preheading ?: 'Board Member' }}</p>
					<h1>{{ entry.title }}</h1>
				</div>
			</div>
		</div>
	</div>
	<div class="c-hero__scoop"></div>
</section>
#}
<section class="c-block">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 col-md-3">
				<p>
					{% set img = entry.image.one %}
					<img class="d-block w-100 img-fluid" src="{{ img.url('responsiveMedium') }}" alt="{{ img.alt ?: entry.title }}" />
				</p>
			</div>
			
			<div class="col-12 col-md-6 col-lg-7">
				<p class="u-preheading">{{ entry.preheading ?: 'Board Member' }}</p>
				<p class="h2">{{ entry.title }}</p>
				
				<div class="c-wysiwyg">
					{{ entry.description }}
				</div>
			</div>
		</div>
	</div>
</section>

<section class="c-block c-block--no-padding-top">
	<!-- SLIDER CONTROLS -->
	<div class="container">
		<div class="d-flex justify-content-between">
			<h2 class="mb-0" style="line-height:37px;">Board Members</h2>
			
			<div class="c-slider__controls" data-snap-slider-nav="slider-board">
				<button class="btn btn-text" data-snap-slider-goto="prev" title="previous">
					<img class="d-block w-100" style="width:37px;height:37px;" src="/dist/img/icon-arrow-circle-left.svg" alt="" aria-hidden="true"/>
				</button>
				
				<button class="btn btn-text" data-snap-slider-goto="next" title="next">
					<img class="d-block w-100" style="width:37px;height:37px;" src="/dist/img/icon-arrow-circle-right.svg" alt="" aria-hidden="true"/>
				</button>
			</div>
		</div>
	</div>
	
	<div class="container-fluid px-0">
		<div class="row gx-0 align-items-center">
			<div class="col-12 py-5 ps-3 pe-0 ps-lg-5">
				
				<!-- wrap slider in div with class='position-relative' -->
				<div class="position-relative">
					<div class="c-slider c-slider--bio-cards pe-4" data-snap-slider="slider-board">
						{% for entry in craft.entries.section('boardMembers').id('not ' ~ entry.id).inReverse().all() %}
							{% set img    = entry.image.one %}
							{% set imgSrc = img.url('responsiveMedium') %}
						<div class="c-slider__slide">
							<div class="c-bio-card" style="background:url('{{ imgSrc }}') center center no-repeat;background-size:cover;">
								<div class="c-bio-card__content">
									{% if entry.preheading != '' %}
									<p class="u-preheading">{{ entry.preheading }}</p>
									{% endif %}
									<h2 class="c-bio-card__heading">{{ entry.title }}</h2>
									
									<p>
										<a href="{{ entry.url }}" class="btn btn-pill btn-outline-secondary js-scroll-snap-link">Read Bio</a>
									</p>
								</div>
							</div>
						</div>
						{% endfor %}
					</div>
				</div>
				<!-- //wrap slider -->
				
			</div>
		</div>
	</div>
</section>
{% js on ready %}
var lastClickedElement = null;

document.onclick = function(e) {
	var e = window.event || e;                // window.event for IE
	if (!e.target) e.target = e.srcElement;   // extend target property for IE
	//console.log(e.target);                  // target is clicked
	
	lastClickedElement = e.target;
}

document.querySelector('.c-slider--bio-cards').SnapSlider.on('scroll.end', function(snapSlider, e) {
	var currentSlide = document.querySelector('.c-slider--bio-cards').SnapSlider.getCurrentSlide();
	//console.log(e);
	//console.log(lastClickedElement);
	
	// if (e.target.classList.contains('c-slider--bio-cards')) {
	if (lastClickedElement.classList.contains('c-slider--bio-cards')) {
		//console.log(e);
		//console.log(currentSlide.querySelectorAll('.js-scroll-snap-link')[0]);
		currentSlide.querySelectorAll('.js-scroll-snap-link')[0].click(); // trigger click event on the current slide's bio button
	}
});
{% endjs %}