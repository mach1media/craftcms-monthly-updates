
{# --------------------- PAGE HEADER -------------------- #}
<section class="position-relative">
	<div class="c-hero c-hero--general">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-12 col-md-8 col-xl-7 text-center">
					<p class="u-preheading">News</p>
					<h1>{{ entry.title }}</h1>
					<p class="opacity-50">{{ entry.postDate | date }}</p>
				</div>
			</div>
		</div>
	</div>
	<div class="c-hero__scoop"></div>
</section>

{# --------------------- PAGE BUILDER OUTPUT -------------------- #}
{% include "_pageBuilders/pageBuilderNewsStory" with { 'entry': entry } %}
