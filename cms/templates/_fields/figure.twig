{% if figure is defined and figure | length and figure.image | length %}
	{% set img    = figure.image.one %}
	{% set full   = (img.width > 2000) ? 2000 : img.width %}
	{% set half   = full / 2 | round %}
	{% set fourth = full / 4 | round %}
<figure class="c-figure c-figure--{% if figure.pulled %}pull-{% endif %}{{ figure.position }}">
	<img src="{{ img.url({ width: half }) }}" alt="{{ img.imageAlt ?: img.title }}"
		srcset="{{ img.url({ width: fourth }) }} {{ fourth }}w,
			{{ img.url({ width: half }) }} {{ half }}w,
			{{ img.url({ width: full }) }} {{ full }}w"
		sizes="(min-width: {{ half + 1 }}px) {{ full }}px,
			(min-width: {{ fourth + 1 }}px) {{ half }}px,
			100vw"
	/>
	{% if img.attribution != '' %}
	<figcaption>{{ img.attribution }}</figcaption>
	{% elseif img.caption != '' %}
	<figcaption>{{ img.caption }}</figcaption>
	{% endif %}
</figure>
{% endif %}