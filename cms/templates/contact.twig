{#
 # HOME PAGE TEMPLATE
 #}
{% extends "_layout/default" %}
 
{% block content %}
<section class="position-relative">
	<div class="c-hero c-hero--general">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-12 col-md-7 text-center">
					<div class="c-hero__home-lead">
						{# <h1>Contact Us</h1> #}
						<p>Join our Spirit-led movement to bring about a better world by empowering the church to help more people know God’s love.</p>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="c-hero__scoop"></div>
</section>

<section class="c-block">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 col-md-10 col-lg-9 col-xl-8">
				{% include "_formie/form-bootstrap" with {'formHandle': 'contact'} %}
			</div>
		</div>
	</div>
</section>

{% endblock %}
