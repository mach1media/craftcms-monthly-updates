{% extends "_layout/default" %}

{# SET PAGE BODY CLASS #}
{# {% set bodyClass = "pagehead-nav-bleed" %} #}

{% block content %}


<!-- HERO: DEFAULT -->
<section class="position-relative">
	<div class="c-hero c-hero--general c-hero--podcast">
		<div class="container">
			<div class="row align-items-center">
				<!-- Intro text -->
				<div class="col-12 col-md-5">
					<p class="u-preheading">Igniting Imagination Podcast</p>
					<h1>Conversations That Inspire Courage and Innovation</h1>
					<p>The Igniting Imagination podcast features rich conversations with prominent leaders from across the cultural and spiritual landscape that invite listeners into new relationships with themselves, their church, and their communities. It offers ideas to strengthen spiritual practice, build community, and inspire courage and innovation.
					</p>
					<p>
						Every movement for change starts with a generative conversation. Join us to spark the Spirit within you as a leader bringing about a world where people know love, grace, joy and belonging.</p>
					<p>
						<a class="btn btn-pill btn-secondary" href="#">Subscribe to Podcast</a> &nbsp;
						<a class="btn btn-pill btn-outline-secondary text-white" href="#">Receive Podcast Email</a>
					</p>
				</div>
				
				<!-- Image for desktop only -->
				<div class="col-12 col-md-4 offset-md-1 d-none d-md-flex">
					<div class="c-hero__img-podcast">
						<img class="d-block w-100 img-fluid" src="/dist/img/hero-podcasts.png" alt="" />
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="c-hero__scoop"></div>
</section>



