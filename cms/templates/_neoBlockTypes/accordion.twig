{##
 # NEO BLOCK TYPE: ACCORDION
 #}
<section id="{{ sectionId }}" class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		{% if block.preheading != '' or block.headingBlock | length or block.description != '' %}
		<div class="row justify-content-center mb-5">
			<div class="col-12 col-md-10 col-lg-9 col-xl-8 text-center">
				{% if block.preheading is defined and block.preheading != '' %}
				<p class="u-preheading">{{ block.preheading }}</p>
				{% endif %}
				{% include "_fields/headingBlock" with {'heading': block.headingBlock} %}
				{% if block.description is defined and block.description != '' %}
				<div class="c-wysiwyg">
					{% apply enkode_emails %}
						{{ block.description }}
					{% endapply %}
				</div>
				{% endif %}
			</div>
		</div>
		{% endif %}
		<div class="row{% if block.paddingSides is defined and block.paddingSides == '1' %} justify-content-center{% endif %}">
			<div class="col-12{% if block.paddingSides is defined and block.paddingSides == '1' %} col-md-10 col-lg-9 col-xl-8{% endif %}">
				{% if block.accordionItems | length %}
				<div class="accordion" id="accordion-{{ block.id }}">
					{% for item in block.accordionItems %}
					<div class="accordion-item">
						<h2 class="accordion-header" id="accordion-heading-{{ item.id }}">
							<button class="accordion-button fs-4{% if not loop.first %} collapsed{% endif %}" type="button" 
								data-bs-toggle="collapse" 
								data-bs-target="#accordion-panel-{{ item.id }}" 
								aria-expanded="{% if loop.first %}true{% else %}false{% endif %}" 
								aria-controls="accordion-panel-{{ item.id }}">
								{{ item.heading }}
							</button>
						</h2>
						<div id="accordion-panel-{{ item.id }}" 
							class="accordion-collapse collapse{% if loop.first %} show{% endif %}" 
							aria-labelledby="accordion-heading-{{ item.id }}"
							data-bs-parent="#accordion-{{ block.id }}">
							<div class="accordion-body">
								{% apply enkode_emails %}{{ item.description }}{% endapply %}
							</div>
						</div>
					</div>
					{% endfor %}
				</div>
				{% endif %}
			</div>
		</div>
	</div>
</section>
