{##
 # NEO BLOCK TYPE: PODCAST EPISODE
 #}
<section class="c-block c-home__podcast">
	<div class="container">
		<div class="row align-items-center">
			<div class="col-12 col-md-6 col-lg-7{% if block.imagePositionLR == 'right' %} order-md-2 ps-md-5{% else %} pe-md-5 mb-5 mb-md-0{% endif %}">
				{{ block.embedCode | raw }}
			</div>
			
			<div class="col-12 col-md-6 col-lg-5{% if block.imagePositionLR == 'right' %} order-md-1 mb-5 mb-md-0{% else %} px-md-5{% endif %}">
				{% if block.preheading is defined and block.preheading != '' %}
				<p class="u-preheading">{{ block.preheading }}</p>
				{% endif %}
				{% if block.heading != '' %}
				<h2 class="text-white mb-3">{{ block.heading }}</h2>
				{% endif %}
				{% if block.description is defined and block.description != '' %}
				<div class="c-wysiwyg">{{ block.description }}</div>
				{% endif %}
				{% if block.button.getLink() %}
				<p>{% include "_fields/button" with {'button': block.button, 'color': 'secondary text-white'} %}</p>
				{% endif %}
			</div>
		</div>
	</div>
</section>