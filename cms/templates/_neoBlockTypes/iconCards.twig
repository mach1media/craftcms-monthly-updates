{##
 # NEO BLOCK TYPE: ICON CARDS
 #}
<section class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row{% if block.paddingSides is defined and block.paddingSides == '1' %} justify-content-center{% endif %}">
			<div class="col-12{% if block.paddingSides is defined and block.paddingSides == '1' %} col-md-10 col-lg-8{% endif %}">
				<div class="row">
					{% for card in block.children.all() %}
					<div class="col-12 col-md-4 px-xl-5 mb-5 mb-md-0 d-flex align-items-stretch">
						<div class="c-icon-card">
							<div class="c-icon-card__icon">
								<img src="/assets/icon/{{ card.icon }}.svg" alt="" aira-hidden="true" />
							</div>
							
							<div class="c-icon-card__description">
								{% if card.textLink.getType != '' %}
									<h2 class="h4">{% include "_fields/link" with {'link': card.textLink, 'class': 'c-icon-card__link'} %}</h2>
								{% elseif card.heading != '' %}
									<h2 class="h4">{{ card.heading }}</h2>
								{% endif %}
								{% if card.summary != '' %}<p>{{ card.summary }}</p>{% endif %}
							</div>
						</div>
					</div>
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
</section>