{##
 # NEO BLOCK TYPE: BUTTON BLOCK
 #}
<section id="{{ sectionId }}" class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row{% if block.paddingSides is defined and block.paddingSides == '1' %} justify-content-center{% endif %}">
			<div class="col-12 text-{{ block.textAlignment }}{% if block.paddingSides is defined and block.paddingSides == '1' %} col-lg-10 col-xl-9{% endif %}">
				
				{% include "_fields/buttons" with {'buttons': block.buttons} %}

			</div>
		</div>
	</div>
</section>