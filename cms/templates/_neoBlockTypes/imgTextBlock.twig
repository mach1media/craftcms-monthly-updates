{##
 # NEO BLOCK TYPE: IMG+TEXT BLOCK
 #}
{% if block.imageDesktop is defined and block.imageDesktop | length %}
	{% set imgDesktop    = block.imageDesktop.one %}
	{% set imgDesktopSrc = imgDesktop.format != 'svg' ? imgDesktop.url('responsiveMedium') : imgDesktop.url %}
	{% set imgDesktopAlt = imgDesktop.alt ?: imgDesktop.caption %}
{% endif %}

{% if block.imageMobile is defined and block.imageMobile | length %}
	{% set imgMobile    = block.imageMobile.one %}
	{% set imgMobileSrc = imgMobile.format != 'svg' ? imgMobile.url('responsiveSmall') : imgMobile.url %}
	{% set imgMobileAlt = imgMobile.alt ?: imgMobile.caption %}
{% endif %}
<section id="{{ sectionId }}" class="c-block c-img-text{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container-fluid px-0">
		<div class="row align-items-center g-0">
			<div class="col-12 col-lg-6 d-flex justify-content-center {% if block.imagePositionLR == 'left' %} justify-content-lg-start order-lg-2{% else %}justify-content-lg-end{% endif %}">
				<div class="c-img-text__description start">
					<div>
						{% if block.preheading is defined and block.preheading != '' %}
						<p class="u-preheading">{{ block.preheading }}</p>
						{% endif %}

						{% include "_fields/headingBlock" with {'heading': block.headingBlock} %}
						
						{% if block.description is defined and block.description != '' %}
						<div class="c-wysiwyg{% if block.buttons | length %} mb-4{% endif %}">
							{% apply enkode_emails %}
								{{ block.description }}
							{% endapply %}
						</div>
						{% endif %}

						{% include "_fields/buttons" with {'buttons': block.buttons} %}
					</div>
				</div>
			</div>
			
			<div class="col-12 col-lg-6{% if block.imagePositionLR == 'left' %} order-lg-1{% endif %}">
				<div class="c-img-text__image {% if block.imagePositionLR == 'right' %}end u-rounded-top-left{% else %}start u-rounded-top-right{% endif %}">
				{% if block.imageDesktop | length and block.imageMobile | length %}
					<img class="d-md-none w-100 img-fluid" src="{{ imgMobile.url('responsiveMedium' ) }}" alt="{{ imgMobile.alt }}" />
					<img class="d-none d-md-block w-100 img-fluid" src="{{ imgDesktop.url('responsiveMedium') }}" alt="{{ imgDesktop.alt }}" />
				{% elseif block.imageDesktop | length %}
					<img class="d-block w-100 img-fluid" src="{{ imgDesktop.url('responsiveMedium') }}" alt="{{ imgDesktop.alt }}" />
				{% endif %}
				</div>
			</div>
		</div>
	</div>
</section>
