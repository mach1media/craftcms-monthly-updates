{##
 # NEO BLOCK TYPE: IMG+TEXT BLOCK
 #}
{% if block.imageDesktop is defined and block.imageDesktop | length %}
	{% set imgDesktop    = block.imageDesktop.one %}
	{% set imgDesktopSrc = imgDesktop.url('responsiveMedium') %}
	{% set imgDesktopAlt = imgDesktop.alt ?: imgDesktop.caption %}
{% endif %}

{% if block.imageMobile is defined and block.imageMobile | length %}
	{% set imgMobile    = block.imageDesktop.one %}
	{% set imgMobileSrc = imgMobile.url('responsiveSmall') %}
	{% set imgMobileAlt = imgMobile.alt ?: imgMobile.caption %}
{% endif %}

{% if block.bleedToEdge == '1' %}
<section class="c-block c-img-text--edge-bleed">
	<div class="container-fluid px-0">
		<div class="row gx-0 justify-content-start">
			<div class="col-12 col-md-5 col-lg-6">
				{% if block.imageDesktop | length and block.imageMobile | length %}
				<img class="d-block d-md-none w-100 img-fluid" src="{{ imgMobileSrc }}" alt="{{ imgMobileAlt }}" />
				<img class="d-none d-md-block w-100 img-fluid" src="{{ imgDesktopSrc }}" alt="{{ imgDesktopAlt }}" />
				{% elseif block.imageDesktop | length %}
				<img class="d-block w-100 img-fluid" src="{{ imgDesktopSrc }}" alt="{{ imgDesktopAlt }}" />
				{% endif %}
			</div>
		</div>
	</div>
	
	<div class="c-img-text__edge-bleed-content">
		<div class="container">
			<div class="row justify-content-end">
				<div class="col-12 col-md-6 col-lg-5">
					{% if block.preheading is defined and block.preheading != '' %}
					<p class="u-preheading">{{ block.preheading }}</p>
					{% endif %}
					{% include "_fields/headingBlock" with {'heading': block.headingBlock} %}
					{% if block.description is defined and block.description != '' %}
					<div class="c-wysiwyg">{{ block.description }}</div>
					{% endif %}
					{% if block.button.getLink() %}
					<p>{% include "_fields/button" with {'button': block.button, 'color': 'secondary'} %}</p>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</section>
{% else %}
<section class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row justify-content-between align-items-center">
			<div class="col-12 col-md-6{% if block.imagePositionLR == 'right' %} order-md-2{% else %} mb-5 mb-md-0{% endif %}">
				{% if block.imageDesktop | length and block.imageMobile | length %}
					<p class="d-md-none"><img class="img-fluid" src="{{ imgMobileSrc }}" alt="{{ imgMobileAlt }}" /></p>
					<p class="d-none d-md-block"><img class="img-fluid" src="{{ imgDesktopSrc }}" alt="{{ imgDesktopAlt }}" /></p>
				{% elseif block.imageDesktop | length %}
					<p><img class="img-fluid" src="{{ imgDesktopSrc }}" alt="{{ imgDesktopAlt }}" /></p>
				{% endif %}
			</div>
			
			<div class="col-12 col-md-5{% if block.imagePositionLR == 'right' %} order-md-1 mb-5 mb-md-0{% endif %}">
				{% if block.preheading is defined and block.preheading != '' %}
				<p class="u-preheading">{{ block.preheading }}</p>
				{% endif %}
				{% include "_fields/headingBlock" with {'heading': block.headingBlock} %}
				{% if block.description is defined and block.description != '' %}
				<div class="c-wysiwyg">{{ block.description }}</div>
				{% endif %}
				{% if block.button.getLink() %}
				<p>{% include "_fields/button" with {'button': block.button, 'color': 'secondary'} %}</p>
				{% endif %}
			</div>
		</div>
	</div>
</section>
{% endif %}