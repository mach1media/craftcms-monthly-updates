{##
 # NEO BLOCK TYPE: COLUMNS
 #}
<section class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		{% if block.headingBlock | length %}
		<div class="row">
			<div class="col-12 mb-5">
				{% include "_fields/headingBlock" with {'heading': block.headingBlock} %}
			</div>
		</div>
		{% endif %}
		
		<div class="row">
			<div class="col-12 col-md-7 pe-md-5 mb-5 mb-md-0{% if block.imagePositionLR == 'right' %} order-md-2{% endif %}">
				{{ block.description }}
				
				{% if block.accordionItems | length %}
				<div class="accordion" id="accordion-{{ block.id }}">
					{% for item in block.accordionItems %}
					<div class="accordion-item">
						<h2 class="accordion-header" id="accordion-heading-{{ item.id }}">
							<button class="accordion-button fs-2" type="button" 
								data-bs-toggle="collapse" 
								data-bs-target="#accordion-panel-{{ item.id }}" 
								aria-expanded="{% if loop.first %}true{% else %}false{% endif %}" 
								aria-controls="accordion-panel-{{ item.id }}">
								{{ item.heading }}
							</button>
						</h2>
						<div id="accordion-panel-{{ item.id }}" class="accordion-collapse collapse{% if loop.first %} show{% endif %}" aria-labelledby="accordion-heading-{{ item.id }}" data-bs-parent="#accordion-{{ block.id }}">
							<div class="accordion-body">
								{{ item.description }}
							</div>
						</div>
					</div>
					{% endfor %}
				</div>
				{% endif %}
			</div>
			
			<div class="col-12 col-md-5 ps-lg-5{% if block.imagePositionLR == 'right' %} order-md-1{% endif %}">
				{% if block.image | length %}
					{% set img    = block.image.one %}
					{% set imgSrc = img.url('responsiveMedium') %}
					{% set imgAlt = img.alt ?: img.caption %}
				<p><img class="img-fluid" src="{{ imgSrc }}" alt="{{ imgAlt }}" /></p>
				{% endif %}
			</div>
		</div>
	</div>
</section>
