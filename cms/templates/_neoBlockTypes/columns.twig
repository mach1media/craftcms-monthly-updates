{##
 # NEO BLOCK TYPE: COLUMNS
 #}
{% set totalColumns = block.children | length %}
{# {% set columnsClass = totalColumns < 4 ? 12 / totalColumns : '6' %} #}
{% set columnsClass = 12 / totalColumns %}
<section id="{{ sectionId }}" class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		{% include "_fields/headingBlock" with {'heading': block.headingBlock, 'class': 'mb-4'} %}
		
		{% if block.description != '' %}
			<div class="text-{{ block.textAlignment }}">{{ block.description }}</div>
		{% endif %}
		
		<div class="row{% if block.paddingSides is defined and block.paddingSides == '1' %} justify-content-center{% endif %}">
			<div class="col-12{% if block.paddingSides is defined and block.paddingSides == '1' %} col-lg-10 col-xl-9{% endif %}">
				
				<div class="row">
					{% for col in block.children.all() %}
					<div class="col-12 col-lg-{{ columnsClass }}{% if not loop.last %} mb-5 mb-lg-0{% endif %} text-{{ col.textAlignment }}">
						<!-- {{ col.type }} -->
						{% if col.type == 'columnText' %}
							{% if col.preheading is defined and col.preheading != '' %}
							<p class="u-preheading mb-0">{{ col.preheading }}</p>
							{% endif %}
							
							{% if col.heading != '' %}
							<h3>{{ col.heading | raw }}</h3>
							{% endif %}
							
							{% if col.description is defined and col.description != '' %}
							<div class="c-wysiwyg{% if col.button | length %} mb-4{% endif %}">
								{% apply enkode_emails %}
									{{ col.description }}
								{% endapply %}
							</div>
							{% endif %}
							
							{% if col.button | length %}
							<p>
								{% if col.button.getLink() %}
									{% include "_fields/button" with {'button': col.button, 'class': 'm-2' } %}
								{% endif %}
							</p>
							{% endif %}
						
						{% elseif col.type == 'columnImage' %}
							{% if col.imageMobile | length and col.imageDesktop | length %}
								{% set img    = col.imageMobile.one %}
								{% set imgSrc = img.url('responsiveMedium') %}
								{% set imgAlt = img.alt ?: img.caption %}
							<p class="d-lg-none"><img class="img-fluid" src="{{ imgSrc }}" alt="{{ imgAlt }}" /></p>
								{% set img    = col.imageDesktop.one %}
								{% set imgSrc = img.url('responsiveMedium') %}
								{% set imgAlt = img.alt ?: img.caption %}
							<p class="d-none d-lg-block"><img class="img-fluid" src="{{ imgSrc }}" alt="{{ imgAlt }}" /></p>
							
							{% elseif col.imageDesktop | length %}
								{% set img    = col.imageDesktop.one %}
								{% set imgSrc = img.url('responsiveMedium') %}
								{% set imgAlt = img.alt ?: img.caption %}
							<p><img class="img-fluid" src="{{ imgSrc }}" alt="{{ imgAlt }}" /></p>
							{% endif %}
						
						{% elseif col.type == 'columnQuote' %}
							<figure>
								<blockquote>{{ block.quote }}</blockquote>
								{% if col.citation != '' %}<figcaption>{{ col.citation }}</figcaption>{% endif %}
							</figure>
							
						{% elseif col.type == 'columnDataTable' %}
							{% if col.dataTable | length %}
							<div class="border border-secondary rounded p-3 mb-3">
								<table class="table table-sm text-primary">
									<thead>
										<tr class="align-bottom">
											{% for col in entry.myTableField.columns %}
												<th align="{{ col.align }}" width="{{ col.width }}">{{ col.heading }}</th>
											{% endfor %}
										</tr>
									</thead>
							
									<tbody>
										{% for row in block.dataTable.rows %}
											<tr>
												{% for cell in row %}
													{% if lop.first %}
													<th align="{{ entry.myTableField.columns[loop.index0].align }}">{{ cell }}</th>
													{% else %}
													<td align="{{ entry.myTableField.columns[loop.index0].align }}">{{ cell }}</td>
													{% endif %}
												{% endfor %}
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
							{% endif %}
							
							{% if block.summary %}
							<p style="font-size:10px;line-height:1.2em;">{{ block.summary | nl2br | raw }}</p>
							{% endif %}
							
						{% endif %}
					</div>
					{% endfor %}
				</div>
				
			</div>
		</div>
	</div>
</section>