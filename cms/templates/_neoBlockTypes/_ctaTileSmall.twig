{##
 # CTA TILE: SMALL (square)
 #}
{% set img          = block.image.one %}
{% set imgSrc       = img.format != 'svg' ? img.url('responsiveMedium') : img.url %}
{% set imgAlt       = img.alt %}
<div class="col-12 col-sm-6 col-lg-3">
	<div class="c-tiles__tile c-tiles__tile--square{% if block.stackImageOnMobile%} c-tiles__tile--stacked-mobile{% endif %}">
		<a class="c-tiles__img-link" href="{{ block.tileLink.getUrl() }}"{% if block.tileLink.getTarget() == '_blank' %} target="_blank"{% endif %}>
			<img src="{{ imgSrc }}" alt="{{ imgAlt }}" />
		</a>
		<div class="c-tiles__description h-100 d-flex flex-column justify-content-between">
			{#
			{% if block.labelCustom != '' and block.iconCustom | length %}
			<span class="c-tiles__icon-custom" style="background: url('{{ block.iconCustom.one.url }}') center center no-repeat;background-size: contain;"></span>
			<p class="u-preheading">{{ block.labelCustom }}</p>
			{% elseif block.label == 'loans' %}
			<span class="c-tiles__icon-loans"></span>
			<p class="u-preheading">Loans</p>
			{% elseif block.label == 'grants' %}
			<span class="c-tiles__icon-grants"></span>
			<p class="u-preheading">Grants</p>
			{% elseif block.label == 'investments' %}
			<span class="c-tiles__icon-investments"></span>
			<p class="u-preheading">Investments</p>
			{% elseif block.label == 'area-representatives' %}
			<span class="c-tiles__icon-area-representatives"></span>
			<p class="u-preheading">Area Representatives</p>
			{% elseif block.label == 'philanthropy' %}
			<span class="c-tiles__icon-philanthropy"></span>
			<p class="u-preheading">Philanthropy</p>
			{% elseif block.label == 'leadership-ministry' %}
			<span class="c-tiles__icon-leadership-ministry"></span>
			<p class="u-preheading">Leadership Ministry</p>
			{% endif %}
			#}
			{% if block.labelCustom != '' %}
			<p class="u-preheading">{{ block.labelCustom }}</p>
			{% elseif block.label == 'loans' %}
			<p class="u-preheading">Loans</p>
			{% elseif block.label == 'grants' %}
			<p class="u-preheading">Grants</p>
			{% elseif block.label == 'investments' %}
			<p class="u-preheading">Investments</p>
			{% elseif block.label == 'area-representatives' %}
			<p class="u-preheading">Area Representatives</p>
			{% elseif block.label == 'philanthropy' %}
			<p class="u-preheading">Philanthropy</p>
			{% elseif block.label == 'leadership-ministry' %}
			<p class="u-preheading">Leadership Ministry</p>
			{% endif %}
			
			{% if block.heading != '' %}<h2 class="h4">{{ block.heading | raw }}</h2>{% endif %}
		</div>
	</div>
</div>