{##
 # IMPACT REPORT PAGE BUILDER: MEDIA
 #}
{% if block.imageDesktop is defined and block.imageDesktop | length %}
	{% set imgDesktop    = block.imageDesktop.one %}
	{% set imgDesktopSrc = imgDesktop.url('responsiveMedium') %}
	{% set imgDesktopAlt = imgDesktop.alt ?: imgDesktop.caption %}
{% endif %}

{% if block.imageMobile is defined and block.imageMobile | length %}
	{% set imgMobile    = block.imageMobile.one %}
	{% set imgMobileSrc = imgMobile.url('responsiveSmall') %}
	{% set imgMobileAlt = imgMobile.alt ?: imgMobile.caption %}
{% endif %}
<section id="{{ sectionId }}"  class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row">
			<div class="col">
				{% if block.imageDesktop | length and block.imageMobile | length %}
					<p class="d-md-none"><img class="img-fluid" style="width:100%;" src="{{ imgMobileSrc }}" alt="{{ imgMobileAlt }}" /></p>
					<p class="d-none d-md-block"><img class="img-fluid" style="width:100%;" src="{{ imgDesktopSrc }}" alt="{{ imgDesktopAlt }}" /></p>
				{% elseif block.imageDesktop | length %}
					<p><img class="img-fluid" style="width:100%;" src="{{ imgDesktopSrc }}" alt="{{ imgDesktopAlt }}" /></p>
				{% elseif block.video | length %}
					{% set embeddedAsset = craft.embeddedAssets.get(block.video.one()) %}
					<div class="js-fitvids" style="aspect-ratio:{{ embeddedAsset.width }}/{{ embeddedAsset.height }};">
						{{ embeddedAsset ? embeddedAsset.html }}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</section>