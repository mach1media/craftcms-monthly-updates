{##
 # NEO BLOCK TYPE: RESOURCE CARDS
 #}
<section class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 col-lg-10 col-xl-9">
				{% if block.preheading != '' 
					or block.headingBlock | length 
					or block.description != ''
				%}
				<div class="text-center mb-4">
					{% if block.preheading is defined and block.preheading != '' %}
					<p class="u-preheading">{{ block.preheading }}</p>
					{% endif %}
					
					{% include "_fields/headingBlock" with {'heading': block.headingBlock} %}
					
					{% if block.description is defined and block.description != '' %}
					<div class="c-wysiwyg">
						{% apply enkode_emails %}
							{{ block.description }}
						{% endapply %}
					</div>
					{% endif %}
				</div>
				{% endif %}

				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 justify-content-center">
					{% for resource in block.resourceCards %}
					{% set asset = resource.resource.one %}
					<div class="col mb-4">
						<article class="c-card card bg-white h-100">
							<div class="card-body d-flex flex-column justify-content-between">
								<div class="text-center">
									{% if resource.thumbnail | length %}
										{% set img    = resource.thumbnail.one %}
										{% set imgSrc = img.url('resourceCard') %}
										{% set imgAlt = img.alt ?: resource.title %}
									{% else %}
										{% set imgSrc = '/dist/img/placeholder-resource-' ~ cycle([1,2,3], loop.index) ~ '.jpg' %}
										{% set imgAlt = 'placeholder' %}
									{% endif %}
									<img class="img-fluid mx-auto" src="{{ imgSrc }}" alt="{{ imgAlt }}" style="max-height:240px;width:auto;">
								</div>
								
								<div class="pt-4 text-center">
									<p>{{ resource.cardTitle ?: asset.title }}</p>
									<a class="btn btn-primary btn-arrow" href="{{ asset.url }}">{{ resource.buttonLabel ?: 'Download' }}</a>
								</div>
							</div>
						</article>
					</div>
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
</section>