{##
 # NEO BLOCK TYPE: DATA TABLE
 #}
{% set colContentSize = 'col-lg-6' %}
{% set colTableSize   = 'col-lg-6' %}

{% if block.tableColumnSize == 'small' %}
	{% set colContentSize = 'col-lg-7' %}
	{% set colTableSize   = 'col-lg-5' %}
{% elseif block.tableColumnSize == 'large' %}
	{% set colContentSize = 'col-lg-5' %}
	{% set colTableSize   = 'col-lg-7' %}
{% endif %}
<section id="{{ sectionId }}" class="c-block c-data-table{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 {{ block.textColor }} {{ colContentSize }} pe-lg-5 mb-5 mb-lg-0">
				{% if block.preheading is defined and block.preheading != '' %}
				<p class="u-preheading">{{ block.preheading }}</p>
				{% endif %}
				
				{% include "_fields/headingBlock" with {'heading': block.headingBlock} %}
				
				{% if block.description is defined and block.description != '' %}
				<div class="c-wysiwyg">
					{% apply enkode_emails %}
						{{ block.description }}
					{% endapply %}
				</div>
				{% endif %}
				
				{% include "_fields/buttons" with {'buttons': block.buttons} %}
			</div>
			
			<div class="col-12 {{ colTableSize }} ps-lg-5">
				{% for table in block.dataTables.all() %}
					
					{##
					 # PRE-DEFINED TABLE
					 #}
					{% if table.type == 'preDefinedTable' %}
						{% set entry = table.table.one %}
						
						{% if table.heading != '' or table.subheading != '' %}
						<p class="h4 mb-3">
							{{ table.heading | raw }}
							{% if table.subheading != '' %}<span class="d-block fs-6 u-base-font opacity-50">{{ table.subheading | raw }}</span>{% endif %}
						</p>
						{% elseif entry.heading != '' or entry.citation != '' %}
						<p class="h4 mb-3">
							{{ entry.heading | raw }}
							{% if entry.citation != '' %}<span class="d-block fs-6 u-base-font opacity-50">{{ entry.citation | raw }}</span>{% endif %}
						</p>
						{% endif %}

						<div class="border border-secondary rounded p-3 mb-3">
							<div class="table-responsive">
								{% set entry = table.table.one %}
								{% if entry.type == 'dataTable' %}
									{% include "_fields/tableCustom" with {'table':entry.dataTable, 'textColor': block.textColor } %}
								{% elseif entry.type == 'rateTable' %}
									{% include "_fields/tableRate" with {'table':entry.rateTable, 'textColor': block.textColor } %}
								{% elseif entry.type == 'openAnAccount' %}
									{% include "_fields/tableOpenAccount" with {'table':entry.openAnAccountTable, 'textColor': block.textColor } %}
								{% endif %}
							</div>
						</div>

						{% if table.tableFooter != '' %}
						<small>{{ table.tableFooter }}</small>
						{% elseif entry.description != '' %}
						<small>{{ entry.description }}</small>
						{% endif %}

					{##
					 # CUSTOM TABLE
					 #}
					{% else %}
						{% if table.heading != '' or table.subheading != '' %}
						<p class="h4 mb-3">
							{{ table.heading | raw }}
							{% if table.subheading != '' %}<span class="d-block fs-6 u-base-font opacity-50">{{ table.subheading | raw }}</span>{% endif %}
						</p>
						{% endif %}

						{% if table.type == 'rateTable' %}
						<div class="border border-secondary rounded p-3 mb-5">
							<div class="table-responsive">
								{% include "_fields/tableRate" with {'table':table.rateTable, 'textColor': block.textColor } %}
							</div>
						</div>
						{% elseif table.type == 'customTable' %}
						<div class="border border-secondary rounded p-3 mb-3">
							<div class="table-responsive">
								{% include "_fields/tableCustom" with {'table':table.customTable, 'textColor': block.textColor } %}
							</div>
						</div>
						{% endif %}

						{% if table.tableFooter != '' %}
						<small>{{ table.tableFooter }}</small>
						{% endif %}
					{% endif %}
				{% endfor %}

				{% if block.summary != '' %}
				<small>
					<p>{{ block.summary | nl2br }}</p>
				</small>
				{% endif %}
			</div>
		</div>
	</div>
</section>