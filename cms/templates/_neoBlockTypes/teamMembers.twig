{##
 # NEO BLOCK TYPE: TEAM MEMBERS
 #}
<section class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row{% if block.paddingSides is defined and block.paddingSides == '1' %} justify-content-center{% endif %}">
			<div class="col-12{% if block.paddingSides is defined and block.paddingSides == '1' %} col-md-10 col-lg-8{% endif %} text-{{ block.textAlignment}}">
				{% if block.preheading is defined and block.preheading != '' %}
				<p class="u-preheading">{{ block.preheading }}</p>
				{% endif %}
				
				{% include "_fields/headingBlock" with {'heading': block.headingBlock} %}
				
				{% if block.description is defined and block.description != '' %}
				<div class="c-wysiwyg">
					{% apply enkode_emails %}
						{{ block.description }}
					{% endapply %}
				</div>									
				{% endif %}
				
				{% if block.teamMembers | length %}
					{% set teamMembers = block.teamMembers.all() %}
				{% elseif block.children | length %}
					{% set teamMembers = block.children.all() %}
				{% endif %}

				<div class="row">
					{% for person in teamMembers %}
					{% set img = person.image.one %}
					<div class="col-12 col-sm-6 col-md-4 col-xl-3 text-center p-5{% if not loop.last %} mb-5{% endif %}">
						{% if img | length %}
						<p>
							{% if person.description != '' %}
							<a href="#modal-{{ person.id }}" data-bs-toggle="modal" data-bs-target="#modal-{{ person.id }}">
								<img class="img-fluid rounded-circle" src="{{ img.url('square600') }}" alt="{{ img.alt ?: img.title }}">
							</a>
							{% else %}
							<img class="img-fluid rounded-circle" src="{{ img.url('square600') }}" alt="{{ img.alt ?: img.title }}">
							{% endif %}
						</p>
						{% endif %}

						{% if person.preheading is defined and person.preheading != '' %}
							<p class="u-preheading mb-0">{{ person.preheading }}</p>
						{% endif %}

						{% if person.title is defined %}
						<h3 class="h5">{{ person.title | raw }}</h3>
							{% if person.heading is defined and person.heading != '' %}
							<p>{{ person.heading | raw }}</p>
							{% endif %}
						{% elseif person.heading is defined and person.heading != '' %}
						<h3 class="h5">{{ person.heading | raw }}</h3>
						{% endif %}

						{% if person.description != '' %}
						<!-- Bio Modal: {{ person.heading }} -->
						<div class="modal fade" id="modal-{{ person.id }}" tabindex="-1" aria-labelledby="modal-{{ person.id }}-label" aria-hidden="true">
							<div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
								<div class="modal-content">
									<div class="modal-body p-md-5">
										<p class="text-end">
											<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
										</p>
										<div class="row">
											<div class="col-12 col-md-4">
												<p>
													<img class="img-fluid rounded-circle mb-5" src="{{ img.url('square600') }}" alt="{{ img.alt ?: img.title }}">
												</p>
											</div>

											<div class="col-12 col-md-8">
												<div class="ps-md-5 text-start">
													{% if person.preheading is defined and person.preheading != '' %}
														<p class="u-preheading mb-0">{{ person.preheading }}</p>
													{% endif %}
													
													{% if person.heading != '' %}
													<h3 class="h5">{{ person.heading | raw }}</h3>
													{% endif %}

													{% apply enkode_emails %}
													<dl class="row mb-4">
														{% if person.email != '' %}
														<dt class="col-sm-3 u-base-font-semibold">Email</dt>
														<dd class="col-sm-9 mb-3 mb-sm-0">{{ person.email }}</dd>
														{% endif %}
														{% if person.phone != '' %}
														<dt class="col-sm-3 u-base-font-semibold">Phone</dt>
														<dd class="col-sm-9 mb-3 mb-sm-0"><a href="{{ person.phone }}">{{ person.phone }}</a></dd>
														{% endif %}
													</dl>

													{{ person.description }}
													{% endapply %}
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
						{% endif %}
					</div>
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
</section>