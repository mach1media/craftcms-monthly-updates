{##
 # NEO BLOCK TYPE: EVENTS
 #}
<section class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row{% if block.paddingSides is defined and block.paddingSides == '1' %} justify-content-center{% endif %}">
			<div class="col-12{% if block.paddingSides is defined and block.paddingSides == '1' %} col-lg-10 col-xl-9{% endif %}">
				{% if block.headingBlock | length %}
				<div class="row mb-5">
					<div class="col-12">
						{% include "_fields/headingBlock" with {'heading': block.headingBlock, 'class': 'h1'} %}
					</div>
				</div>
				{% endif %}
				
				{% for card in block.children.all() %}
				<article class="row mb-5 c-event__listing">
					<div class="col-12 col-md-4 col-lg-3 mb-4 mb-md-0">
						<div class="c-event__listing-thumb {{ card.eventImageAccent }}">
							{% if card.thumbnail | length %}
							{% set img = card.thumbnail.one %}
							<img class="w-100 img-fluid" src="{{ img.url('responsiveSmall') }}" alt="{{ img.alt ?: img.caption }}" />
							{% endif %}
						</div>
					</div>
					
					<div class="col-12 col-md-8 col-lg-9">
						{% if card.textLink.getLink() %}
						<h2 class="fs-4 text-uppercase"><a class="stretched-link" href="{{ card.textLink }}">{{ card.heading }}</a></h2>
						{% else %}
						<h2 class="fs-4 text-uppercase">{{ card.heading }}</h2>
						{% endif %}
						{% if card.date != '' or card.time != '' %}
							{% set dateTime = [] %}
							{% if card.date != '' %}{% set dateTime = dateTime|merge([card.date|date('l, F d, Y')]) %}{% endif %}
							{% if card.time != '' %}{% set dateTime = dateTime|merge([card.time]) %}{% endif %}
							<p class="u-font-heading">{{ dateTime|join(' | ')}}</p>
						{% endif %}
						{{ card.description }}
					</div>
				</article>
				{% endfor %}
			</div>
		</div>
	</div>
</section>