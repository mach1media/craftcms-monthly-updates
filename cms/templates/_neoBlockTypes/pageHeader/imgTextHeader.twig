{##
 # NEO BLOCK TYPE: PAGE HEADER: IMG+TEXT
 #}
{% set imgDesktop = block.imageDesktop.one %}
{% set imgMobile  = block.imageMobile.one %}
<section class="c-block c-block--no-padding-bottom bg-secondary-extralight c-img-text">
	<div class="container-fluid px-0">
		<div class="row align-items-center g-0">
			<div class="col-12 col-lg-6 d-flex justify-content-center justify-content-lg-end">
				<div class="c-img-text__description start me-xl-5 pe-xl-5">
					<div class="me-xxl-5 pe-xxl-5">
						<p class="c-breadcrumb">
							{% for ancestor in entry.ancestors %}
								<a href="{{ ancestor.url }}">{{ ancestor.title }}</a>
							{% endfor %}
							{{ entry.title }}
						</p>

						<h1>{{ block.heading != '' ? block.heading : entry.title }}</h1>
						
						{% if block.description is defined and block.description != '' %}
						<div class="c-wysiwyg">{{ block.description }}</div>
						{% endif %}

						{% include "_fields/buttons" with {'buttons': block.buttons} %}
					</div>
				</div>
			</div>

			<div class="col-12 col-lg-6">
				<div class="c-img-text__image end u-rounded-top-left">
					{% if block.imageDesktop | length and block.imageMobile | length %}
						<img class="d-md-none w-100 img-fluid" src="{{ imgMobile.url('responsiveMedium' ) }}" alt="{{ imgMobile.alt }}" />
						<img class="d-none d-md-block w-100 img-fluid" src="{{ imgDesktop.url('responsiveMedium') }}" alt="{{ imgDesktop.alt }}" />
					{% elseif block.imageDesktop | length %}
						<img class="d-block w-100 img-fluid" src="{{ imgDesktop.url('responsiveMedium') }}" alt="{{ imgDesktop.alt }}" />
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</section>
