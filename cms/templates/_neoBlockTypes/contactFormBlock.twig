{##
 # NEO BLOCK TYPE: CONTACT FORM BLOCK
 #}
<!-- CONTACT FORM BLOCK -->
<section id="{{ sectionId }}" class="c-contact">
	<div class="container">
		<div class="row justify-content-between g-0">
			<div class="col-12 col-lg-5 col-xl-4 {{ block.textColor }} c-contact__description">
				<p>
					<img class="d-block w-50" src="/dist/img/contact-form-preheading-headshots.png" alt="">
				</p>
				{% if block.preheading is defined and block.preheading != '' %}
				<p class="u-preheading">{{ block.preheading }}</p>
				{% endif %}
				
				{% include "_fields/headingBlock" with {'heading': block.headingBlock, 'class': 'mb-4'} %}
				
				{% if block.description is defined and block.description != '' %}
				<div class="c-wysiwyg">
					{% apply enkode_emails %}
						{{ block.description }}
					{% endapply %}
				</div>
				{% endif %}

				<div class="row justify-content-between mt-5">
					<div class="col-12 col-md-6">
						<p class="u-preheading">Contact</p>
						<p>
							phone: (800) 933-5502<br />
							Fax: (512) 331-0670
						</p>
						<p>
							<a href="mailto:info@tmf.org">info@tmf.org</a>
						</p>
					</div>

					<div class="col-12 col-md-6">
						<p class="u-preheading">Address</p>
						<p>
							11709 Boulder Lane, Ste. 100<br />
							Austin, TX 78726
						</p>
					</div>
				</div>
			</div>

			<div class="col-12 col-lg-6 c-contact__form">
				<h2 class="{{ block.textColor }} mb-5">Reach Out</h2>

				<div class="c-form">
					{% include "_formie/form-bootstrap" with { form: block.form } %}
				</div>
			</div>
		</div>
	</div>
</section>
