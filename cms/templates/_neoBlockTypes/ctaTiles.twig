{##
 # NEO BLOCK TYPE: CTA TILES
 #}
<section class="c-block">
	<div class="container">
		<div class="row g-3 c-tiles">
			{% for row in block.children.all() %}
				{% if row.type == 'largeSmallSmall' %}
					{% for block in row.ctaTileLarge.all %}
						{% include "_neoBlockTypes/_ctaTileLarge" with { block: block } %}
					{% endfor %}
					
					{% for block in row.ctaTileSmall.all %}
						{% include "_neoBlockTypes/_ctaTileSmall" with { block: block } %}
					{% endfor %}

				{% elseif row.type == 'smallSmallLarge' %}
					{% for block in row.ctaTileSmall.all %}
						{% include "_neoBlockTypes/_ctaTileSmall" with { block: block } %}
					{% endfor %}

					{% for block in row.ctaTileLarge.all %}
						{% include "_neoBlockTypes/_ctaTileLarge" with { block: block } %}
					{% endfor %}

				{% endif %}
			{% endfor %}
		</div>
	</div>
</section>