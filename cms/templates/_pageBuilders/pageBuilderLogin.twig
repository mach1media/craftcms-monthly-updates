{# Eager-load the Neo field #}
{% for block in entry.pageBuilderLogin %}
	{% do block.useMemoized() %}
{% endfor %}

{# Loop through eager-loaded Neo fields blocks #}
{% for block in entry.pageBuilderLogin %}
{% if block.level == 1 %}

<!-- {{ block.type }}: {{ block.id }} -->
{% if block.description is defined and block.description != '' %}
<div class="c-wysiwyg{% if block.button | length %} mb-4{% endif %}">
	{% apply enkode_emails %}
		{{ block.description }}
	{% endapply %}
</div>
{% endif %}

{% if block.button | length %}
<p class="text-center">
	{% if block.button.getLink() %}
		{% include "_fields/button" with {'button': block.button, 'color': block.buttonStyle } %}
	{% endif %}
</p>
{% endif %}

{% endif %}
{% endfor %}