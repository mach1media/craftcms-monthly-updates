{#
 # BASE TEMPLATE: NEWS SECTION
 #}
{% extends "_layout/default" %}

{% set perPage = 6 %}
{% set allNewsEntries = craft.entries.section('news') %}
{% set query = allNewsEntries.limit(perPage) %}
{% paginate query as pageInfo, pageEntries %}


{% block content %}


<section class="c-block bg-secondary-extralight">
	<div class="container">
		<div class="row justify-content-center mb-5">
			<div class="col-10 col-md-8 col-lg-7 col-xl-6 text-center mb-md-5">
				<h1>News & Stories</h1>
			</div>
		</div>
		
		<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 justify-content-center">
			{% for entry in pageEntries %}
				{% if entry.thumbnail | length %}
					{% set img    = entry.thumbnail.one %}
					{% set imgSrc = img.url('previewCard') %}
					{% set imgAlt = img.alt ?: entry.title %}
				{% else %}
					{% set imgSrc = '/dist/img/placeholder-' ~ cycle([1,2,3], loop.index) ~ '.jpg' %}
					{% set imgAlt = 'placeholder' %}
				{% endif %}
				<div class="col mb-4">
					<article class="c-card card bg-white h-100">
						<a href="{{ entry.url }}">
							<img class="c-card__img d-block w-100 rounded-top" src="{{ imgSrc }}" alt="{{ imgAlt }}">
						</a>
						
						<div class="card-body d-flex flex-column justify-content-between">
							<div>
								<p class="c-card__date">{{ entry.postDate | date }}</p>
								<h2 class="fs-4 u-font-heading-bold">{{ entry.title }}</h2>
								{% if entry.summary != '' %}
								<p class="opacity-75">{{ entry.summary | raw }}</p>
								{% endif %}
							</div>
							
							<div class="pt-4">
								{% if entry.textLink.getLink() %}
									{% include "_fields/button" with {
										'button': entry.textLink, 
										'color': 'btn-outline-secondary', 
										'style': 'btn-sm btn-pill stretched-link'
									} %}
								{% else %}
									<a href="{{ entry.url }}" class="btn btn-sm btn-outline-secondary">Read More</a>
								{% endif %}
							</div>
						</div>
					</article>
				</div>
			{% endfor %}
		</div>

		{% if allNewsEntries | length > perPage %}
		<div class="row">
			<div class="col text-center">
				<nav aria-label="News entries pagination">
					<ul class="pagination justify-content-center">
						<li class="page-item"><a class="page-link" href="{{ pageInfo.firstUrl }}">&laquo;</a></li>
						{% if pageInfo.prevUrl %}
						<li class="page-item"><a class="page-link" href="#">Prev</a></li>
						{% endif %}
						{% for page, url in pageInfo.getPrevUrls(3) %}
						<li class="page-item"><a class="page-link" href="{{ url }}">{{ page }}</a></li>
						{% endfor %}
						<li class="page-item active" aria-current="page"><a class="page-link" href="#">{{ pageInfo.currentPage }}</a></li>
						{% for page, url in pageInfo.getNextUrls(3) %}
						<li class="page-item"><a class="page-link" href="{{ url }}">{{ page }}</a></li>
						{% endfor %}
						{% if pageInfo.nextUrl %}
						<li class="page-item"><a class="page-link" href="#">Next</a></li>
						{% endif %}
						<li class="page-item"><a class="page-link" href="{{ pageInfo.lastUrl }}">&raquo;</a></li>
					</ul>
				</nav>
			</div>
		</div>
		{% endif %}
	</div>
</section>


{% endblock %}