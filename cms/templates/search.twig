{#
 # SEARCH RESULTS TEMPLATE
 #}
{% extends "_layout/default" %}

{% set searchQuery = craft.app.request.getParam('q') %}

{# get pages #}
{% set searchSections = [
	'pages',
	'news'
]
%}
{% set pages = craft.entries.section(searchSections).search(searchQuery).orderBy('score').all() %}
 
{% block content %}

<section class="c-block">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 col-md-10 col-lg-8">
				<h1>Search Results</h1>
				<p class="h4 mb-5">{{ pages|length }} results for &ldquo;{{ searchQuery }}&rdquo;</p>

				<ol>
				{% for entry in pages %}
					<li class="pt-3 mt-3 border-top">
						<p class="mb-0"><a href="{{ entry.url }}">{{ entry.title }}</a></p>
						{% if entry.section.handle == 'news' %}
							<p class="c-card__date mb-0">News: {{ entry.postDate | date }}</p>
							{% if entry.summary != '' %}
							<p class="opacity-75">{{ entry.summary | raw }}</p>
							{% endif %}
						{% elseif entry.level > 1 %}
							<p class="opacity-50"><small>Home / {% for ancestor in entry.ancestors.all() %}{{ ancestor.title }}{% if not loop.last %} / {% endif %}{% endfor %}</small></p>
						{% endif %}
					</li>
				{% endfor %}
				</ol>
			</div>
		</div>
	</div>
</section>
{% endblock %}
