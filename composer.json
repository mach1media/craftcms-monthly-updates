{
  "require": {
    "craftcms/cms": "^4.17.12",
    "craftcms/feed-me": "^5.2.0",
    "craftcms/mailgun": "3.1.0",
    "craftcms/redactor": "^3.0.4",
    "dolphiq/redirect": "^2.0.0",
    "hybridinteractive/craft-position-fieldtype": "^4.0.0",
    "miranj/craft-obfuscator": "^1.1.1",
    "mmikkel/cp-field-inspect": "^1.4.4",
    "nystudio107/craft-seomatic": "^4.0.33",
    "sebastianlenz/linkfield": "^2.1.5",
    "spicyweb/craft-embedded-assets": "^4.0.0",
    "spicyweb/craft-neo": "^4.0.2",
    "statikbe/craft-config-values": "^2.0.2",
    "topshelfcraft/wordsmith": "^4.2.0",
    "verbb/field-manager": "^3.0.6",
    "verbb/formie": "^2.2.17",
    "verbb/redactor-tweaks": "^3.0.0",
    "verbb/super-table": "^3.0.9",
    "verbb/tablemaker": "^4.0.18",
    "vlucas/phpdotenv": "^5.4.0"
  },
  "require-dev": {
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/",
      "modules\\mailchimp\\": "modules/mailchimp/src/"
    }
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\""
    ]
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ]
}
