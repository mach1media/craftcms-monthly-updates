{#
 # HOME PAGE TEMPLATE
 #}
{% extends "_layout/default" %}

{% if entry is not defined %}
	{% set entry = craft.entries.section('homepage').one() %}
{% endif %}
 
{% block content %}
	
{# --------------------- ALERT BAR -------------------- #}
{% include "_components/alertBar" with { 'entry': entry } %}

<!-- HOMEPAGE HERO WITH CTA TILES -->
<section class="c-block">
	<div class="container">
		<div class="row">
			<div class="col-12">
				
				<div class="c-tiles__home"> 
					{# INTRO HEADING AND LINK #}
					{% if entry.homeIntro | length %}
					{% set block = entry.homeIntro %}
					<div class="c-tiles__tile">
						<div class="h-100 d-flex flex-column justify-content-end">
							<div class="row align-items-end">
								<div class="col-12 col-xl-8">
									{% if block.preHeading != '' %}<p class="u-preheading text-secondary">&ndash; {{ block.preHeading }}</p>{% endif %}
									{% if block.heading != '' %}<h1 class="h2">{{ block.heading }}</h1>{% endif %}
								</div>

								<div class="col-12 col-xl-4">
									{% if block.ctaLink | length %}
									<p><a class="u-link-chevron" href="{{ block.ctaLink.getIntrinsicUrl() }}">{{ block.ctaLink.getText() }}</a></p>
									{% endif %}
								</div>
							</div>
						</div>
					</div>
					{% endif %}

					{# WIDE VIDEO TILE #}
					{% if entry.homeTileWide | length %}
					{% set block = entry.homeTileWide.one() %}
					{% set thumb = block.thumbnail.one %}
						{% if block.type == 'videoTile' %}
						<div class="c-tiles__tile c-tiles__tile--wide c-tiles__tile--video">
							<div class="row g-0 h-100 position-relative">
								<div class="col-12 col-sm-6 p-0 position-relative">
									<span class="c-tiles__play-icon">
										<img src="{{ thumb.url('square600') }}" alt="{{ thumb.alt }}" />
										<span class="visually-hidden">Watch video</span>
									</span>
								</div>

								<div class="col-12 col-sm-6">
									<div class="h-100 d-flex flex-column justify-content-between">
										{% if block.label != '' %}
										<p class="u-preheading text-primary">{{ block.label }}</p>
										{% endif %}

										{% if block.heading != '' %}
										<h2 class="h3">
											<a class="stretched-link" href="">{{ block.heading }}</a>
										</h2>
										{% endif %}
									</div>
								</div>
							</div>
						</div>
						{% else %}
						<div class="c-tiles__tile">
							<a class="c-tiles__img-link" href="{{ block.ctaLink.getIntrinsicUrl() }}">
								<img src="{{ thumb.url('responsiveLarge') }}" alt="{{ thumb.alt }}" />
							</a>
							<div class="c-tiles__description h-100 d-flex flex-column justify-content-between">
								{% if block.labelCustom != '' and block.iconCustom | length %}
								<p class="u-preheading">{{ block.labelCustom }}</p>
								{% elseif block.label == 'loans' %}
								<p class="u-preheading">Loans</p>
								{% elseif block.label == 'grants' %}
								<p class="u-preheading">Grants</p>
								{% elseif block.label == 'investments' %}
								<p class="u-preheading">Investments</p>
								{% elseif block.label == 'area-representatives' %}
								<p class="u-preheading">Area Representatives</p>
								{% elseif block.label == 'philanthropy' %}
								<p class="u-preheading">Philanthropy</p>
								{% elseif block.label == 'leadership-ministry' %}
								<p class="u-preheading">Leadership Ministry</p>
								{% endif %}
								
								<h2 class="h4">{{ block.heading ?: block.ctaLink.getText() }}</h2>
							</div>
						</div>
						{% endif %}
					{% endif %}

					{# LARGE FEATURE TILE #}
					{% if entry.homeFeatureTile | length %}
					{% set block = entry.homeFeatureTile.one() %}
					{% set img = block.image.one %}
					<div class="c-tiles__tile c-tiles__tile--featured">
						<a class="c-tiles__img-link" href="{{ block.ctaLink.getIntrinsicUrl() }}">
							<img src="{{ img.url('responsiveLarge') }}" alt="{{ img.alt }}" />
						</a>
						<div class="c-tiles__description h-100 d-flex flex-column justify-content-between">
							{% if block.labelCustom != '' and block.iconCustom | length %}
							<p class="u-preheading">{{ block.labelCustom }}</p>
							{% elseif block.label == 'loans' %}
							<p class="u-preheading">Loans</p>
							{% elseif block.label == 'grants' %}
							<p class="u-preheading">Grants</p>
							{% elseif block.label == 'investments' %}
							<p class="u-preheading">Investments</p>
							{% elseif block.label == 'area-representatives' %}
							<p class="u-preheading">Area Representatives</p>
							{% elseif block.label == 'philanthropy' %}
							<p class="u-preheading">Philanthropy</p>
							{% elseif block.label == 'leadership-ministry' %}
							<p class="u-preheading">Leadership Ministry</p>
							{% endif %}

							<div>
								{% if block.heading != '' %}<h2 class="h3">{{ block.heading }}</h2>{% endif %}
								<div class="c-tiles__description-footer"><span class="text-white">{{ block.ctaLink.getText() }}</span></div>
							</div>
						</div>
					</div>
					{% endif %}

					{% for block in entry.homeSquareTiles.all() %}
					{% set img          = block.thumbnail.one %}
					{% set imgSrc       = img.url('responsiveMedium') %}
					{% set imgAlt       = img.alt %}
					<div class="c-tiles__tile">
						<a class="c-tiles__img-link" href="{{ block.ctaLink.getIntrinsicUrl() }}">
							<img src="{{ img.url('responsiveLarge') }}" alt="{{ img.alt }}" />
						</a>
						<div class="c-tiles__description h-100 d-flex flex-column justify-content-between">
							{% if block.labelCustom != '' and block.iconCustom | length %}
							<p class="u-preheading">{{ block.labelCustom }}</p>
							{% elseif block.label == 'loans' %}
							<p class="u-preheading">Loans</p>
							{% elseif block.label == 'grants' %}
							<p class="u-preheading">Grants</p>
							{% elseif block.label == 'investments' %}
							<p class="u-preheading">Investments</p>
							{% elseif block.label == 'area-representatives' %}
							<p class="u-preheading">Area Representatives</p>
							{% elseif block.label == 'philanthropy' %}
							<p class="u-preheading">Philanthropy</p>
							{% elseif block.label == 'leadership-ministry' %}
							<p class="u-preheading">Leadership Ministry</p>
							{% endif %}

							<h2 class="h4">{{ block.heading ?: block.ctaLink.getText() }}</h2>
						</div>
					</div>
					{% endfor %}
				</div>

			</div>
		</div>
	</div>
</section>
	
{# --------------------- PAGE BUILDER OUTPUT -------------------- #}
{% include "_pageBuilders/pageBuilderGeneral" with { 'entry': entry } %}
	
{# --------------------- POPUP -------------------- #}
{% include "_components/popup" with { 'entry': entry } %}

{% endblock %}
