{##
 # NEWS LANDING PAGE TEMPLATE
 #}
{% extends "_layout/default" %}

{% set categorySlug = craft.app.request.getSegments | last %}
{% set category     = craft.categories.group('newsCategories').slug(categorySlug).one() %}

{% set perPage = 6 %}
{% set allNewsEntries = craft.entries.section('news').relatedTo(category) %}
{% set query = allNewsEntries.limit(perPage) %}
{% paginate query as pageInfo, pageEntries %}


{% block content %}

<section class="c-block bg-secondary-extralight">
	<div class="container">
		<div class="row">
			<div class="col-12 mb-md-5">
				{% include "news/_headerFilter" with {
					'heading': category.title,
					'category': category
				} %}
			</div>
		</div>
		
		<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 justify-content-center">
			{% for entry in pageEntries %}
				<div class="col mb-4">
					{% include "_components/cardNews" with {'entry': entry} %}
				</div>
			{% endfor %}
		</div>

		{% if allNewsEntries | length > perPage %}
			<div class="row">
				<div class="col text-center">
					{% include "_components/pagination" with {
						'paginationLabel': 'News Pagination',
						'pageInfo': pageInfo
					} %}
				</div>
			</div>
		{% endif %}
	</div>
</section>

{% endblock %}
