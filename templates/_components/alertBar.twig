{##
 # ALERT BAR COMPONENT
 #}
{% set block = entry.alertBar.one() %}
{% if block %}
<div class="c-alert-bar {{ block.backgroundColor }}">
	<div class="container">
		<div class="row">
			<div class="col-12 p-3">
				<div class="c-wysiwyg text-center u-base-font-semibold {{ block.textColor }}">
					{% apply enkode_emails %}
						{{ block.message }}
					{% endapply %}
				</div>
			</div>
		</div>
	</div>
</div>
{% endif %}