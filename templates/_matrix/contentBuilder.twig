{##
 # Matrix Field Output: Content Builder
 #
 # Template: _matrix/contentBuilder.twig
 #
 # This template handles the section wrapper for all content builder blocks.
 # Each entry type is rendered via block.render() which outputs to _partials/entry/{handle}.twig
 #}
{% for block in entry.contentBuilder.all() %}
{% apply spaceless %}

{# = = = = = = = = = = SECTION SETTING DEFAULTS = = = = = = = = = = #}
{% set sectionSpacingClassesDefault      = ['py-5'] %}
{% set sectionContainerSizingDefault     = 'container' %}
{% set sectionJustifyContentDefault      = 'justify-content-center' %}
{% set sectionContentWidthClassesDefault = ['col-12', 'col-lg-10'] %}
{% set sectionWidth                      = block.cbSectionWidth is defined ? block.cbSectionWidth.value : null %}

{# - - - - - - - - - SECTION SETTINGS FROM ENTRY - - - - - - - - - #}
{% set sectionId              = 'section-' ~ block.id %}
{% set sectionTextAlign       = block.cbTextAlign is defined ? block.cbTextAlign.value : null %}
{% set sectionTextColor       = block.cbTextColor is defined ? block.cbTextColor.value : null %}
{% set sectionBackgroundColor = block.cbBackgroundColor is defined ? block.cbBackgroundColor.value : null %}

{# Process section spacing - cbSectionSpacing is a checkboxes field #}
{% set sectionSpacing = [] %}
{% if block.cbSectionSpacing is defined and block.cbSectionSpacing | length %}
	{% for option in block.cbSectionSpacing %}
		{% set sectionSpacing = sectionSpacing | merge([option.value]) %}
	{% endfor %}
{% endif %}

{% if sectionSpacing | length == 0 %}
	{% set sectionSpacing = sectionSpacingClassesDefault %}
{% endif %}

{# set section classes, removing empty values #}
{% set sectionClasses = [
	'c-section',
	sectionBackgroundColor,
	sectionTextColor,
	sectionSpacing | join(' '),
] | filter(v => v) %}

{# Set container settings based on entry type #}
{% switch block.type.handle %}
	{% case 'cbHeadingBlock' %}
		{% set sectionJustifyContent      = sectionJustifyContentDefault %}
		{% set sectionContainerSizing     = sectionContainerSizingDefault %}
		{% set sectionContentWidthClasses = sectionContentWidthClassesDefault %}
		{% set sectionTextAlign           = sectionTextAlign | default('text-center') %}
		{% set sectionClasses             = sectionClasses | merge([sectionTextAlign]) %}

	{% case 'cbTextBlock' %}
		{% set sectionJustifyContent      = sectionJustifyContentDefault %}
		{% set sectionContainerSizing     = sectionContainerSizingDefault %}
		{% set sectionContentWidthClasses = sectionContentWidthClassesDefault %}
		{% if sectionTextAlign %}
			{% set sectionClasses = sectionClasses | merge([sectionTextAlign]) %}
		{% endif %}

	{% case 'cbImageBlock' %}
		{% set sectionJustifyContent      = sectionJustifyContentDefault %}
		{% if sectionWidth == 'viewport' %}
			{% set sectionContainerSizing     = 'container-fluid px-0' %}
			{% set sectionContentWidthClasses = ['col-12'] %}
		{% elseif sectionWidth == 'container' %}
			{% set sectionContainerSizing     = sectionContainerSizingDefault %}
			{% set sectionContentWidthClasses = ['col-12'] %}
		{% else %}
			{% set sectionContainerSizing     = sectionContainerSizingDefault %}
			{% set sectionContentWidthClasses = sectionContentWidthClassesDefault %}
		{% endif %}

	{% case 'cbEmbedCodeBlock' %}
		{% set sectionJustifyContent      = sectionJustifyContentDefault %}
		{% set sectionContainerSizing     = sectionContainerSizingDefault %}
		{% set sectionContentWidthClasses = sectionContentWidthClassesDefault %}

	{% default %}
		{% set sectionJustifyContent      = sectionJustifyContentDefault %}
		{% set sectionContainerSizing     = sectionContainerSizingDefault %}
		{% set sectionContentWidthClasses = sectionContentWidthClassesDefault %}
{% endswitch %}

{## ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~
 # BLOCK CONTENT
 # _partials/entry/[entryTypeHandle].twig
 #}
{% set blockContent %}
	{{ block.render({
		sectionId: sectionId,
		sectionTextAlign: sectionTextAlign,
		sectionTextColor: sectionTextColor,
		sectionBackgroundColor: sectionBackgroundColor
	}) }}
{% endset %}

{## ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~
 # BLOCK CONTENT WRAPPER
 #}
{% set blockContentWrapper %}
	<div class="{{ sectionContainerSizing }}">
		<div class="row {{ sectionJustifyContent }}">
			<div class="col {{ sectionContentWidthClasses | join(' ') }}">
				{{ blockContent }}
			</div>
		</div>
	</div>
{% endset %}

{% endapply %}

{## = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =
 # FINAL OUTPUT
 #}
<!-- {{ block.type }}: {{ block.id }} -->
<section id="{{ sectionId }}"
	class="{{ sectionClasses | join(' ') }}"
	data-block-type="{{ block.type.handle }}"
	data-block-id="{{ block.id }}">
	{% if sectionWidth == 'viewport' %}
		{{ blockContent }}
	{% else %}
		{{ blockContentWrapper }}
	{% endif %}
</section>

{% endfor %}
