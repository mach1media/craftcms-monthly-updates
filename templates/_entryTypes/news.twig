
{# --------------------- PAGE HEADER -------------------- #}
<section class="c-block">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-10 col-md-8 col-lg-7 col-xl-6 text-center">
				<p class="c-breadcrumb">
					<a href="{{ siteUrl }}">Home</a>
					<a href="{{ url('news') }}">News</a>
					Post
				</p>
				
				<h1>{{ entry.title }}</h1>
				
				<div class="c-wysiwyg">
					<p class="opacity-50">{{ entry.postDate | date }}</p>
				</div>
			</div>
		</div>
	</div>
</section>


<section class="c-block c-block--no-padding-top">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 col-xl-10">

				{# --------------------- PAGE BUILDER OUTPUT -------------------- #}
				{% include "_pageBuilders/pageBuilderBlog" with { 'entry': entry } %}

			</div>
		</div>
	</div>
</section>


<section class="c-block bg-secondary-extralight">
	<div class="container">
		<div class="row">
			<div class="col text-center">

				<button onclick="history.back()" class="btn btn-secondary">&larr; Back</button>

			</div>
		</div>
	</div>
</section>
