<section class="c-login">
	<div class="container-fluid gx-0">
		<div class="row g-0">
			<div class="d-none d-md-flex col-md-6 col-lg-8">
				<div class="c-login__photo">
					{% if entry.backgroundPhoto | length %}
						{% set img = entry.backgroundPhoto.one %}
						{% set imgSrc = img.format != 'svg' ? img.url('responsiveLarge') : img.url() %}
						<img src="{{ imgSrc }}" alt="{{ img.alt ?: img.title }}">
					{% endif %}
				</div>
			</div>

			<div class="col-12 col-md-6 col-lg-4">
				<div class="c-login__content">
					<div class="mx-auto">
						{% if entry.image | length %}
							{% set img = entry.image.one %}
							{% set imgSrc = img.format != 'svg' ? img.url('responsiveMedium') : img.url() %}
							<p class="text-center"><img src="{{ imgSrc }}" alt="{{ img.alt ?: img.title }}" style="max-width:50%;"><p>
						{% endif %}

						{% include "_fields/headingBlock" with {'heading': entry.headingBlock} %}
						
						{# --------------------- PAGE BUILDER OUTPUT -------------------- #}
						{% include "_pageBuilders/pageBuilderLogin" with { 'entry': entry } %}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
