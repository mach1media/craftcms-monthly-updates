{##
 # Entry Type: CB: Text Block
 #
 # Template: _partials/entry/cbTextBlock.twig
 #
 # Used in: contentBuilder Matrix field
 #
 # Fields:
 #   - heading (plainText)
 #   - description (cbRichText - CKEditor)
 #
 # Variables passed from contentBuilder.twig:
 #   - sectionId, sectionTextAlign, sectionTextColor, sectionBackgroundColor
 #}

{% set heading = entry.heading | default(null) %}
{% set description = entry.description | default(null) %}

<div class="c-text-block">
	{% if heading %}
		<h2 class="c-text-block__heading mb-4">{{ heading }}</h2>
	{% endif %}

	{% if description %}
		<div class="c-text-block__description">
			{{ description }}
		</div>
	{% endif %}
</div>
