{##
 # Entry Type: News Landing Page
 #
 # Template: _partials/entry/newsLandingPage.twig
 #
 # Section(s): news
 #
 # Fields:
 #   - pageHeader (Neo field)
 #
 # Queries:
 #   - News articles from 'news' section (with eager loading)
 #
 # Includes:
 #   - _fields/pageHeader
 #   - _fields/button
 #}

{% set newsArticles = craft.entries()
	.section('news')
	.eagerly(['thumbnail', 'textLink'])
	.all() %}

{# --------------------- PAGE HEADER -------------------- #}
{% include "_fields/pageHeader" with { 'entry': entry } %}

<section class="c-block">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 col-md-10 col-lg-9 col-xl-8">

				{% for newsEntry in newsArticles %}
				<article class="position-relative row justify-content-between{% if not loop.first %} mt-5{% endif %} pt-5 border-top{% if loop.last %} mb-5 pb-5 border-bottom{% endif %}">
					<div class="col-12 col-md-4 col-xl-3 mb-4">
						{% set img = newsEntry.thumbnail.one() | default(null) %}
						{% if img %}
							{% set imgSrc = img.url() %}
							{% set imgAlt = img.alt %}
						{% else %}
							{% set imgSrc = '/dist/img/logo-mark.png' %}
							{% set imgAlt = 'placeholder' %}
						{% endif %}
						<img class="img-fluid" src="{{ imgSrc }}" alt="{{ imgAlt }}" />
					</div>

					<div class="col-12 col-md-7 col-xl-8">
						<p class="u-preheading">{{ newsEntry.postDate|date }}</p>
						<h2 class="h3 c-news__card-heading">{{ newsEntry.title }}</h2>
						{% if newsEntry.summary | default %}<p>{{ newsEntry.summary }}</p>{% endif %}
						<p>
							{% set link = newsEntry.textLink | default(null) %}
							{% if link and link.value %}
								{% include "_fields/button" with {
									'button': link,
									'color': 'secondary',
									'style': 'pill stretched-link'
								} %}
							{% else %}
								<a class="btn btn-secondary btn-pill stretched-link" href="{{ newsEntry.url }}">Read More</a>
							{% endif %}
						</p>
					</div>
				</article>
				{% endfor %}

			</div>
		</div>
	</div>
</section>
