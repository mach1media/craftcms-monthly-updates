{##
 # Entry Type: Portal Login Page
 #
 # Template: _partials/entry/portalLogin.twig
 #
 # Section(s): portalLogin
 #
 # Fields:
 #   - backgroundPhoto (Asset)
 #   - image (Asset - logo)
 #   - headingBlock (Content Block)
 #   - pageBuilder (Neo field)
 #
 # Includes:
 #   - _fields/headingBlock
 #   - _pageBuilders/pageBuilderLogin
 #}

{% set backgroundPhoto = entry.backgroundPhoto.eagerly().one() | default(null) %}
{% set logo = entry.image.eagerly().one() | default(null) %}

<section class="c-login">
	<div class="container-fluid gx-0">
		<div class="row g-0">
			<div class="d-none d-md-flex col-md-6 col-lg-8">
				<div class="c-login__photo">
					{% if backgroundPhoto %}
						{% set imgSrc = backgroundPhoto.format != 'svg' ? backgroundPhoto.url('responsiveLarge') : backgroundPhoto.url() %}
						<img src="{{ imgSrc }}" alt="{{ backgroundPhoto.alt | default(backgroundPhoto.title) }}">
					{% endif %}
				</div>
			</div>

			<div class="col-12 col-md-6 col-lg-4">
				<div class="c-login__content">
					<div class="mx-auto">
						{% if logo %}
							{% set logoSrc = logo.format != 'svg' ? logo.url('responsiveMedium') : logo.url() %}
							<p class="text-center"><img src="{{ logoSrc }}" alt="{{ logo.alt | default(logo.title) }}" style="max-width:50%;"><p>
						{% endif %}

						{% include "_fields/headingBlock" with {'heading': entry.headingBlock} %}

						{# --------------------- PAGE BUILDER OUTPUT -------------------- #}
						{% include "_pageBuilders/pageBuilderLogin" with { 'entry': entry } %}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
