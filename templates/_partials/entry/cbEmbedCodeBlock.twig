{##
 # Entry Type: CB: Embed Code Block
 #
 # Template: _partials/entry/cbEmbedCodeBlock.twig
 #
 # Used in: contentBuilder Matrix field
 #
 # Fields:
 #   - embedCode (plainTextMultilineMonospace)
 #
 # Variables passed from contentBuilder.twig:
 #   - sectionId, sectionTextAlign, sectionTextColor, sectionBackgroundColor
 #}

{% set embedCode = entry.embedCode | default(null) %}

{% if embedCode %}
<div class="c-embed-code-block">
	{{ embedCode | raw }}
</div>
{% endif %}
