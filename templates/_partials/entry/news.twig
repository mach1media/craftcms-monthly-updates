{##
 # Entry Type: News Article
 #
 # Template: _partials/entry/news.twig
 #
 # Section(s): news
 #
 # Fields:
 #   - title (Entry Title)
 #   - postDate (Post Date)
 #   - summary (Plain Text)
 #   - thumbnail (Asset)
 #   - textLink (Link field)
 #
 # Includes:
 #   - _pageBuilders/pageBuilderBlog (Neo field: pageBuilder)
 #}

{# --------------------- PAGE HEADER -------------------- #}
<section class="c-block">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-10 col-md-8 col-lg-7 col-xl-6 text-center">
				<h1>{{ entry.title }}</h1>

				<div class="c-wysiwyg">
					<p class="opacity-50">{{ entry.postDate | date }}</p>
				</div>
			</div>
		</div>
	</div>
</section>


{# --------------------- PAGE BUILDER OUTPUT -------------------- #}
{% include "_pageBuilders/pageBuilderBlog" with { 'entry': entry } %}


<section class="c-block bg-secondary-extralight">
	<div class="container">
		<div class="row">
			<div class="col text-center">

				<button onclick="history.back()" class="btn btn-secondary">&larr; Back</button>

			</div>
		</div>
	</div>
</section>
