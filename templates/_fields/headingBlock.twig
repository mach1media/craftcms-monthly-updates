{% if heading | length and heading.heading != '' %}
{% switch heading.alignment %}
	{% case 'left' %}
		{% set textAlignment = 'text-start' %}
	{% case 'center' %}
		{% set textAlignment = 'text-center' %}
	{% case 'right' %}
		{% set textAlignment = 'text-end' %}
{% endswitch %}
<h2 class="{{ heading.size != 'h2 ' ? heading.size : '' }} {{ textAlignment }} {{ heading.textColor }}{% if class is defined and class != '' %} {{ class }}{% endif %}">{{ heading.heading | raw }}</h2>
{% endif %}