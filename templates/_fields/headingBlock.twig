{# Super Table field - get the first entry #}
{% set headingEntry = heading.one() | default(null) %}
{% if headingEntry and headingEntry.heading | default %}
{% switch headingEntry.alignment | default('left') %}
	{% case 'left' %}
		{% set textAlignment = 'text-start' %}
	{% case 'center' %}
		{% set textAlignment = 'text-center' %}
	{% case 'right' %}
		{% set textAlignment = 'text-end' %}
	{% default %}
		{% set textAlignment = 'text-start' %}
{% endswitch %}
<h2 class="{{ headingEntry.size | default('') != 'h2 ' ? headingEntry.size | default('') : '' }} {{ textAlignment }} {{ headingEntry.textColor | default('') }}{% if class is defined and class != '' %} {{ class }}{% endif %}">{{ headingEntry.heading | raw }}</h2>
{% endif %}