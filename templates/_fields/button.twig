{% if button.value | default %}
	{% set classes = ['btn'] %}
	{% if color is defined and color != '' %}
		{% set classes = classes|merge([color]) %}
	{% endif %}
	{% if style is defined and style != '' %}
		{% set classes = classes|merge([style]) %}
	{% endif %}
	{% if class is defined and class != '' %}
		{% set classes = classes|merge([class]) %}
	{% endif %}
	{{ tag('a', {
		href: button.value,
		target: button.target,
		class: classes | join(' '),
		download: (download is defined and download == 1) ? 'download' : null,
		text: button.label | default(button.element.title | default('Learn More'))
	}) }}
{% endif %}