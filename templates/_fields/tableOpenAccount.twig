<table class="table table-sm {{ textColor is defined ? textColor : 'text-primary' }}">
	<thead>
		<tr class="align-bottom">
			<th class="text-left p-md-3 p-lg-4" align="left" width="33%">
				Impact Certificates<br />
				Church or Agency
			</th>
			<th class="text-left p-md-3 p-lg-4" align="left" width="33%">
				Equity & Bond Investing<br />
				for Nonprofits
			</th>
			<th class="text-left p-md-3 p-lg-4" align="left" width="33%">
				Impact Certificates<br />
				for Individuals
			</th>
		</tr>
	</thead>

	<tbody>
		{% for row in table.all() %}
			<tr>
				<td class="text-left pe-3 p-md-3 p-lg-4" align="left">{{ row.churchOrAgency }}</td>
				<td class="text-left px-3 p-md-3 p-lg-4" align="left">{{ row.nonprofits }}</td>
				<td class="text-left ps-3 p-md-3 p-lg-4" align="left">{{ row.individuals }}</td>
			</tr>
		{% endfor %}
	</tbody>
</table>