{% if textLink.value | default %}
	{% set classes = color is defined ? [color] : [] %}
	{% if class is defined and class != '' %}
		{% set classes = classes|merge([class]) %}
	{% endif %}
	{{ tag('a', {
		href: textLink.value,
		target: textLink.target,
		class: classes | join(' ') ?: null,
		text: textLink.label | default(textLink.element.title | default('Learn More'))
	}) }}
{% endif %}