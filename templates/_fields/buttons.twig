{% if buttons | length %}
<p>
	{% for button in buttons %}
		{% set link = button.btnLink | default(null) %}
		{% if link and link.value %}
			{% include "_fields/button" with {
				'button':   link,
				'color':    button.btnStyle,
				'class':    button.arrow == 1 ? 'btn-arrow m-2' : 'm-2',
				'download': button.download
			} %}
		{% endif %}
	{% endfor %}
</p>
{% endif %}