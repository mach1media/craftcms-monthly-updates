{##
 # NEO BLOCK TYPE: PAGE HEADER: PODCASTS
 #}
<section class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-10 col-md-8 col-lg-7 col-xl-6 text-center">
				<p class="c-breadcrumb">
					{% for ancestor in entry.ancestors %}
						<a href="{{ ancestor.url }}">{{ ancestor.title }}</a>
					{% endfor %}
					{% if entry.showEntryTitle %}
						{{ entry.title }}
					{% endif %}
				</p>
				
				{% if block.heading != '' %}
					<h1>{{ block.heading | raw }}</h1>
				{% elseif entry.showEntryTitle == 1 %}
					<h1>{{ entry.title }}</h1>
				{% endif %}

				{% if block.description is defined and block.description != '' %}
				<div class="c-wysiwyg">
					{% apply enkode_emails %}
						{{ block.description }}
					{% endapply %}
				</div>
				{% endif %}

				{% include "_fields/buttons" with {'buttons': block.buttons} %}
			</div>
		</div>
	</div>
</section>