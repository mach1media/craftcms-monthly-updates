{##
 # NEO BLOCK TYPE: GRANT RECIPIENT CARDS
 #}
<section id="{{ sectionId }}" class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 col-lg-10 col-xl-9 {{ block.textColor }}">
				{% if block.preheading != '' 
					or block.headingBlock | length 
					or block.description != ''
				%}
				<div class="text-center mb-4">
					{% if block.preheading is defined and block.preheading != '' %}
					<p class="u-preheading">{{ block.preheading }}</p>
					{% endif %}
					
					{% include "_fields/headingBlock" with {'heading': block.headingBlock} %}
					
					{% if block.description is defined and block.description != '' %}
					<div class="c-wysiwyg">
						{% apply enkode_emails %}
							{{ block.description }}
						{% endapply %}
					</div>
					{% endif %}
				</div>
				{% endif %}

				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 justify-content-center">
					{% for entry in block.grantRecipients.all() %}
					<div class="col mb-4">
						<article class="c-card card bg-white h-100">
							<div class="card-body d-flex flex-column justify-content-between">
								<div>
									{% if entry.image | length %}
										{% set img    = entry.image.one %}
										{% set imgSrc = img.url('grantRecipientCardLogo') %}
										{% set imgAlt = img.alt ?: entry.title %}
										<div class="d-flex align-items-end mb-4" style="height:80px;">
											<img class="img-fluid me-auto" src="{{ imgSrc }}" alt="{{ imgAlt }}" style="max-height:80px;width:auto;">
										</div>
									{% endif %}
									<h2 class="fs-5 u-base-font text-uppercase text-secondary">{{ entry.programProjectName ?: entry.title }}</h2>
									{% if entry.summary != '' %}
									<p class="opacity-75">{{ entry.summary | raw }}</p>
									{% endif %}
								</div>
								
								{% if entry.website != '' %}
								<div class="pt-4">
									<a class="btn btn-sm btn-outline-secondary" href="{{ entry.website }}" rel="noopener" target="_blank">Learn More</a>
								</div>
								{% endif %}
							</div>
						</article>
					</div>
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
</section>