{##
 # NEO BLOCK TYPE: VIDEO EMBEDS
 #}
{% set totalColumns = block.children | length %}
{% set columnsClass = totalColumns < 4 ? 12 / totalColumns : '6' %}
<section id="{{ sectionId }}" class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row{% if block.paddingSides is defined and block.paddingSides == '1' %} justify-content-center{% endif %}">
			<div class="col-12{% if block.paddingSides is defined and block.paddingSides == '1' %} col-md-10 col-lg-8{% endif %}">
				{% include "_fields/headingBlock" with {'heading': block.headingBlock, 'class': 'mb-4'} %}
				
				<div class="row">
					{% for col in block.children.all() %}
					<div class="col-12 col-md-{{ columnsClass }}">
						<div class="js-fitvids">
						{% if col.videoUrl.media.providerName | lower == 'youtube' %}
							{% set videoId = col.videoUrl.media.url | youtubeId %}
							<iframe class="embed-responsive-item" width="560" height="315" src="https://www.youtube-nocookie.com/embed/{{ videoId }}" title="{{ col.videoUrl.media.title }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
						{% else %}
							{{ craft.oembed.render(col.videoUrl) }}
						{% endif %}
						</div>
					</div>
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
</section>