{##
 # PAGE HEADER: HERO
 #}
{% set bgPhoto = '' %}
{% if block.backgroundPhoto|length %}
	{% set img = block.backgroundPhoto.one %}
	{% set bgPhoto = ' style="background:url(' ~ img.url('responsiveLarge') ~ ') center center no-repeat;background-size:cover;"' %}
{% endif %}
<section class="c-pagehead c-pagehead--hero">
	<div class="c-pagehead__hero"{{ bgPhoto | raw }}>
		<div class="container">
			<div class="row">
				<div class="col-12 col-md-8 col-lg-6 text-center text-md-left">
					{% if block.heading is defined and block.heading != '' %}<h1>{{ block.heading | raw }}</h1>{% endif %}
				</div>
			</div>
		</div>
	</div>
	{% if block.description is defined and block.description != '' 
		 or block.button is defined and block.button | length %}
	<div class="c-pagehead__lead c-block">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-12 col-lg-10 text-center">
					{{ block.description }}
					{% if block.button | length %}
					{% set btnColor = not block.buttonColor ? 'white' : block.buttonColor %}
					<p>{% include "_fields/button" with {'button': block.button, 'color': btnColor} %}</p>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
	{% endif %}
</section>
