{##
 # NEO BLOCK TYPE: GENERAL
 #}
{% set imgDesktop       = block.imageDesktop is defined and block.imageDesktop | length ? block.imageDesktop.one : false %}
{% set imgMobile        = block.imgMobile is defined and block.imageMobile | length ? block.imageMobile.one : false %}
{% set gridWidth        = block.gridWidth is defined ? block.gridWidth : false %}
{% set imagePositionLR  = block.imagePositionLR | default(false) %}
{% set imagePositionLCR = block.positionLCR | default(false) %}

{% set imgFloat    = 'none' %}
{% set imgPosition = imagePositionLCR | default(imagePositionLR) %}

{% if imgPosition | default == 'right' %}
	{% set imgFloat = 'end' %}
{% elseif imgPosition | default == 'left' %}
	{% set imgFloat = 'start' %}
{% elseif imgPosition | default == 'center' %}
	{% set imgFloat = 'none' %}
{% endif %}

{% set image %}
	{% set imgClasses  = ['col-12','col-md-' ~ gridWidth, 'float-md-' ~ imgFloat, 'mb-4'] %}
	
	{% if imgPosition == 'left' %}
		{% set imgClasses = imgClasses|merge(['me-md-4']) %}
	{% elseif imgPosition == 'right' %}
		{% set imgClasses = imgClasses|merge(['ms-md-4']) %}
	{% elseif imgPosition == 'center' %}
		{% set imgClasses = imgClasses|merge(['d-block','mx-md-auto']) %}
	{% endif %}
	
	{% if imgMobile and imgDesktop %}
		{% set imgMobileClasses = imgClasses|merge(['d-md-none']) %}
		{% include "_fields/image" with {
			img : imgMobile,
			class : imgMobileClasses | join(' ')
		} %}

		{% set imgDesktopClasses = imgClasses|merge(['d-none','d-md-block']) %}
		{% include "_fields/image" with {
			img : imgDesktop,
			class : imgDesktopClasses | join(' ')
		} %}
	
	{% elseif imgDesktop %}
		{% include "_fields/image" with {
			img : imgDesktop,
			class : imgClasses | join(' ')
		} %}
	{% endif %}
{% endset %}

{# text alignment #}
{% set textAlignment = ' text-' ~ block.textAlignment %}
{% if block.textAlignment == 'left' %}
	{% set textAlignment = ' text-start' %}
{% elseif block.textAlignment == 'right' %}
	{% set textAlignment = ' text-end' %}
{% endif %}

{# {% if 'c-block--news' not in sectionStyleClasses %} #}
<section id="{{ sectionId }}" class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row{% if block.paddingSides is defined and block.paddingSides == '1' %} justify-content-center{% endif %}">
			<div class="col-12 {{ block.textColor }}{% if block.paddingSides is defined and block.paddingSides == '1' %} col-lg-10 col-xl-9{% endif %}">
				{% if block.preheading is defined and block.preheading != '' %}
				<p class="u-preheading{{ textAlignment }}">{{ block.preheading }}</p>
				{% endif %}
				
				{% include "_fields/headingBlock" with {'heading': block.headingBlock} %}
				
				{% if block.description is defined and block.description != '' %}
				<div class="c-wysiwyg clearfix{% if block.buttons | length %} mb-4{% endif %}{{ textAlignment }}">
					{{ image | default }}
					{% apply enkode_emails %}
						{{ block.description | raw }}
					{% endapply %}
				</div>
				{% endif %}

				{% if block.button %}
					<p class="mt-4{{ textAlignment }}">
						{% include "_fields/button" with {
							'button': block.button, 
							'color': 'secondary', 
							'style': block.buttonStyle
						} %}
					</p>
				{% else %}
					<p class="mt-4{{ textAlignment }}">
						{% include "_fields/buttons" with {'buttons': block.buttons} %}
					</p>
				{% endif %}
			</div>
		</div>
	</div>
</section>