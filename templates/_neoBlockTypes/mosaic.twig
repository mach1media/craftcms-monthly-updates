{##
 # NEO BLOCK TYPE: MOSAIC
 #}
<section class="c-block">
	<div class="container">
		<div class="row align-items-center">
			
			<div class="col-12 col-lg-7 mb-5 mb-lg-0">
				<div class="c-mosaic"> 
					{% set img = block.images.one %}
					<div class="c-mosaic__large">
						<img src="{{ img.url('responsiveLarge') }}" alt="{{ img.alt ?: img.caption }}" />
					</div>
					
					{% set img = block.images.offset(1).one %}
					<div class="c-mosaic__medium">
						<img src="{{ img.url('responsiveMedium') }}" alt="{{ img.alt ?: img.caption }}" />
					</div>
					
					{% set img = block.images.offset(2).one %}
					<div class="c-mosaic__small-1">
						<img src="{{ img.url('responsiveSmall') }}" alt="{{ img.alt ?: img.caption }}" />
					</div>
					
					{% set img = block.images.offset(3).one %}
					<div class="c-mosaic__small-2">
						<img src="{{ img.url('responsiveSmall') }}" alt="{{ img.alt ?: img.caption }}" />
					</div> 
				</div>
			</div>
			
			<div class="col-12 col-lg-5 ps-lg-5">
				{% include "_fields/headingBlock" with {'heading': block.headingBlock, 'class': 'mb-4'} %}
				{% if block.description != '' %}
				<div class="lead">
					{{ block.description }}
				</div>
				{% endif %}
				{% if block.button.getLink() %}
				{% set btnColor = block.buttonColor == 'default' ? 'white' : block.buttonColor %}
				<p>{% include "_fields/button" with {'button': block.button, 'color': btnColor, 'class':'btn-lg'} %}</p>
				{% endif %}
			</div>
			
		</div>
	</div>
</section>
