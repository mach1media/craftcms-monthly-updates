{##
 # NEO BLOCK TYPE: CTA: GENERAL
 #}
{% set bgPhoto = '' %}
{% if block.backgroundPhoto|length %}
	{% set img = block.backgroundPhoto.one %}
	{% set bgPhoto = ' style="background:url(' ~ img.url('responsiveLarge') ~ ') center center no-repeat;background-size:cover;"' %}
{% endif %}
<section id="{{ sectionId }}" id="{{ sectionId }}" class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}"{{ bgPhoto | raw }}>
	<div class="container">
		<div class="row{% if block.paddingSides is defined and block.paddingSides == '1' %} justify-content-center{% endif %}">
			<div class="col-12{% if block.paddingSides is defined and block.paddingSides == '1' %} col-lg-10 col-xl-9{% endif %} text-center">
				{% include "_fields/headingBlock" with {'heading': block.headingBlock, 'class': 'mb-4'} %}
				<div class="lead">{{ block.description }}</div>
				{% if block.button.value | default %}
				{% set btnColor = not block.buttonColor ? 'white' : block.buttonColor %}
				<p>{% include "_fields/button" with {'button': block.button, 'color': btnColor} %}</p>
				{% endif %}
			</div>
		</div>
	</div>
</section>