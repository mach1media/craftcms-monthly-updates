{##
 # NEO BLOCK TYPE: MENU CARDS
 #}
<section class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row{% if block.paddingSides is defined and block.paddingSides == '1' %} justify-content-center{% endif %}">
			<div class="col-12{% if block.paddingSides is defined and block.paddingSides == '1' %} col-lg-10 col-xl-9{% endif %}">
				{% if block.headingBlock | length %}
				<div class="row mb-5">
					<div class="col-12">
						{% include "_fields/headingBlock" with {'heading': block.headingBlock, 'class': 'h1'} %}
					</div>
				</div>
				{% endif %}
				
				<div class="row">
					{% for card in block.children.all() %}
					<div class="col-12 col-md-6 col-xl-3 mb-5 mb-xl-0 text-center">
						<div class="c-menu-card rounded-5" style="background:url('{{ card.backgroundPhoto.one.url('responsiveMedium') }}') center center no-repeat;background-size:cover;">
							<div class="c-menu-card__head bg-{{ card.buttonColor }}">
								<a href="{{ card.button.value }}" class="btn btn-outline-white stretched-link">{{ card.button.label | default('View Menu') }}</a>
							</div>
						</div>
						{% if card.caption != '' %}
						<p class="mt-5 lead">{{ card.caption }}</p>
						{% endif %}
					</div>
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
</section>