{##
 # NEO BLOCK TYPE: PAGE HEADER: GENERAL
 #}
<section id="{{ sectionId }}" class="c-block c-heading-bar {{ block.backgroundColor }}">
	<div class="container">
		<div class="d-md-flex justify-content-between align-items-center">
			<h2 class="c-heading-bar__heading {{ block.textColor }}">{{ block.heading | raw }}</h2>

			<div class="c-heading-bar__buttons">
				{% for button in block.buttons %}
					{% if button.btnLink.value | default %}
						{% include "_fields/button" with {
							'button': button.btnLink, 
							'color': button.btnStyle, 
							'class': button.arrow == 1 ? 'btn-arrow m-2' : 'm-2' 
						} %}
					{% endif %}
				{% endfor %}
			</div>
		</div>
	</div>
</section>
