{##
 # NEO BLOCK TYPE: TEXT+FIGURES IN GUTTER
 #}
{% if block.children | length %}
<div class="c-gutter-figures">
{% for row in block.children.all() %}
{% apply spaceless %}

{% set paddingTop    = row.paddingTop | default(false) %}
{% set paddingBottom = row.paddingBottom | default(false) %}
{% set textColor     = row.textColor | default(false) %}

{% set blockClasses = [
	paddingTop ? '' : 'pt-4',
	paddingBottom ? '' : 'pb-4',
	textColor ? textColor : '',
	'mb-4'
] %}

{% set image         = row.image.one() | default(false) %}
{% set imgPosition   = row.positionLCR | default('center') %}{# left, center, right #}
{% set imgSize       = row.textSize | default() %}{# small, default, large #}
{% set imgCaption    = row.caption | default(image.caption) %}
{% set figureClasses = [
	'position-relative',
	'rounded-3',
	'shadow',
	'pull-' ~ imgPosition,
	'size-' ~ imgSize,
] %}

{% switch imgPosition %}
	{# - - - - - CENTER - - - - - #}
	{% case 'center' %}
		{% if imgSize == 'small' %}
			{% set figureClasses = figureClasses | merge([
				'col-11',
				'col-md-8',
				'col-lg-6',
				'col-xl-4',
				'mx-auto',
				'mb-4',
			]) %}
		{% elseif imgSize == 'default' %}
			{% set figureClasses = figureClasses | merge([
				'col-11',
				'col-md-10',
				'col-lg-8',
				'col-xl-7',
				'mx-auto',
				'mb-4',
			]) %}
		{% elseif imgSize == 'large' %}
			{% set figureClasses = figureClasses | merge([
				'col-11',
				'col-md-10',
				'mx-auto',
				'mb-4',
				'mb-lg-5',
			]) %}
		{% endif %}

	{# - - - - - LEFT - - - - - #}
	{% case 'left' %}
		{% if imgSize == 'small' %}
			{% set figureClasses = figureClasses | merge([
				'col-11',
				'col-sm-8',
				'col-md-4',
				'col-lg-3',
				'float-md-start',
				'mx-auto',
				'me-md-4',
				'me-lg-5',
			]) %}
		{% elseif imgSize == 'large' %}
			{% set figureClasses = figureClasses | merge([
				'col-11',
				'col-sm-8',
				'col-md-7',
				'col-xl-8',
				'float-md-start',
				'mx-auto',
				'me-md-4',
				'me-lg-5',
			]) %}
		{% else %}
			{% set figureClasses = figureClasses | merge([
				'col-11',
				'col-sm-8',
				'col-md-6',
				'col-xl-4',
				'float-md-start',
				'mx-auto',
				'me-md-4',
				'me-lg-5',
			]) %}
		{% endif %}

	{# - - - - - RIGHT - - - - - #}
	{% case 'right' %}
		{% if imgSize == 'small' %}
			{% set figureClasses = figureClasses | merge([
				'col-11',
				'col-sm-8',
				'col-md-4',
				'col-lg-3',
				'float-md-end',
				'mx-auto',
				'ms-md-4',
				'ms-lg-5',
			]) %}
		{% elseif imgSize == 'large' %}
			{% set figureClasses = figureClasses | merge([
				'col-11',
				'col-sm-8',
				'col-md-7',
				'col-xl-8',
				'float-md-end',
				'mx-auto',
				'ms-md-4',
				'ms-lg-5',
			]) %}
		{% else %}
			{% set figureClasses = figureClasses | merge([
				'col-11',
				'col-sm-8',
				'col-md-6',
				'col-xl-4',
				'float-md-end',
				'mx-auto',
				'ms-md-4',
				'ms-lg-5',
			]) %}
		{% endif %}

{% endswitch %}

{% set descriptionClasses = [
	'col-11',
	'col-lg-9',
	'col-xl-6',
	'mx-auto',
	'px-md-5',
	row.textColor,
] %}

{% set imageClasses = [
	'd-block',
	'w-100',
	'img-fluid',
	'rounded-top-3'
] %}
{% if row.caption == '' %}
	{% set imageClasses = imageClasses | merge(['rounded-bottom-3']) %}
{% endif %}

{% set image %}
	{% if image %}
		<figure{% if figureClasses | default %} class="{{ figureClasses | join(' ') }}"{% endif %}>
			{% include "_fields/image" with {
				img : image,
				class : imageClasses | join(' '),
			} %}
			{% if imgCaption != '' %}
				<figcaption class="p-3 text-primary bg-primary-extralight" style="font-size:85%;">{{ imgCaption | raw }}</figcaption>
			{% endif %}
		</figure>
	{% endif %}
{% endset %}

{% endapply %}
{% if imgPosition == 'center' and imgSize != 'small' %}
<div class="clearfix"></div>
{% endif %}
<div class="c-gutter-figures__block{{ blockClasses | length ? ' ' ~ blockClasses | join(' ') : '' }}">
	{% if image %}
		{{ image | raw }}
	{% endif %}
	
	{% if row.description != '' %}
		<div class="c-gutter-figures__description {{ descriptionClasses | join(' ') }}">
			{{ row.description }}
		</div>
	{% endif %}
</div>
{% endfor %}
</div>
{% endif %}
