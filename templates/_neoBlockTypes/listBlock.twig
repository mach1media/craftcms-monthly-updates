{##
 # NEO BLOCK TYPE: LIST BLOCK
 #}
{% apply spaceless %}

{# heading alignment #}
{% set headingAlignment = 'text-start' %}
{% if block.headingBlock | length and block.headingBlock.heading != '' %}
	{% switch block.headingBlock.alignment %}
		{% case 'left' %}
			{% set textAlignment = 'text-start' %}
		{% case 'center' %}
			{% set textAlignment = 'text-center' %}
		{% case 'right' %}
			{% set textAlignment = 'text-end' %}
	{% endswitch %}
{% endif %}

{# list settings #}
{% set listSettings = block.listSettings[0] %}
{% set arrangement  = listSettings.arrangement %}
{% set columns      = listSettings.columns %}
{% set alignment    = listSettings.alignment %}
{% set gap          = listSettings.gap %}

{# set list markup #}
{% set listMarkup %}
	{% if arrangement == 'grid' %}
		<ul class="list-unstyled row g-{{ gap }}">
			{% for item in block.listItemsSimple %}
				<li class="col-12 {{ columns }} text-{{ alignment }}">
					{{ item.listItem | raw }}
				</li>
			{% endfor %}
		</ul>

	{% elseif arrangement == 'inline' %}
		{% set inlineClasses = [] %}
		{% if alignment == 'center' %}
			{% set inlineClasses = inlineClasses | merge(['d-flex', 'justify-content-center', 'flex-wrap']) %}
		{% elseif alignment == 'end' %}
			{% set inlineClasses = inlineClasses | merge(['d-flex', 'justify-content-end', 'flex-wrap']) %}
		{% endif %}
		<ul class="list-inline{{ inlineClasses ? ' ' ~ inlineClasses | join(' ') : '' }}">
			{% for item in block.listItemsSimple %}
				<li class="list-inline-item m-{{ gap }}">
					{{ item.listItem | raw }}
				</li>
			{% endfor %}
		</ul>

	{% elseif arrangement == 'vertical' %}
		<ul class="list-unstyled">
			{% for item in block.listItemsSimple %}
				<li class="text-{{ alignment }} m-{{ gap }}">
					{{ item.listItem | raw }}
				</li>
			{% endfor %}
		</ul>
		
	{% endif %}
{% endset %}

{% endapply %}
<section id="{{ sectionId }}" class="c-block {{ sectionStyleClasses | default }}">
	<div class="container">
		<div class="row{% if block.paddingSides is defined and block.paddingSides == '1' %} justify-content-center{% endif %}">
			<div class="col-12 {{ block.textColor }}{% if block.paddingSides is defined and block.paddingSides == '1' %} col-lg-10 col-xl-9{% endif %}">
				{% if block.preheading | default %}
					<p class="u-preheading {{ headingAlignment }}">
						{{ block.preheading }}
					</p>
				{% endif %}
				
				{% include "_fields/headingBlock" with {
					heading: block.headingBlock
				} %}
				
				{{ listMarkup }}
			</div>
		</div>
	</div>
</section>