{##
 # CTA TILE: SMALL (square)
 #}
{% set img          = block.image.one %}
{% set imgSrc       = img.format != 'svg' ? img.url('responsiveMedium') : img.url %}
{% set imgAlt       = img.alt %}
{% set tileLink     = block.tileLink %}
<div class="col-12 col-sm-6{% if medium is not defined or not medium %} col-lg-3{% endif %}">
	<div class="c-tiles__tile c-tiles__tile--square{% if block.stackImageOnMobile%} c-tiles__tile--stacked-mobile{% endif %}">
		<a class="c-tiles__img-link"
			href="{{ tileLink.getUrl() }}"
			{% if tileLink.getType == 'asset' and tileLink.getElement.kind == 'json' %}
				data-bs-toggle="modal"
				data-bs-target="#video-{{ tileLink.getElement.id }}"
			{% endif %}
			{% if tileLink.getTarget() == '_blank' %}
				target="_blank"
			{% endif %}>
			<img src="{{ imgSrc }}" alt="{{ imgAlt }}" />
		</a>

		<div class="c-tiles__description h-100 d-flex flex-column justify-content-between">
			{% if block.labelCustom != '' %}
				<p class="u-preheading">{{ block.labelCustom }}</p>
			{% elseif block.label == 'loans' %}
				<p class="u-preheading">Loans</p>
			{% elseif block.label == 'grants' %}
				<p class="u-preheading">Grants</p>
			{% elseif block.label == 'investments' %}
				<p class="u-preheading">Investments</p>
			{% elseif block.label == 'area-representatives' %}
				<p class="u-preheading">Area Representatives</p>
			{% elseif block.label == 'philanthropy' %}
				<p class="u-preheading">Philanthropy</p>
			{% elseif block.label == 'leadership-ministry' %}
				<p class="u-preheading">Leadership Ministry</p>
			{% endif %}
			
			{% if block.heading != '' %}
				<h2 class="h4">{{ block.heading | raw }}</h2>
			{% endif %}
		</div>
	</div>

	{% if tileLink.getType == 'asset' and tileLink.getElement.kind | default == 'json' %}
		<!-- Modal -->
		<div class="modal fade" id="video-{{ tileLink.getElement.id }}" tabindex="-1" aria-labelledby="video-{{ tileLink.getElement.id }}-label" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered modal-xl">
				<div class="modal-content bg-dark">
					<div class="modal-body">
						{% set video = craft.embeddedAssets.get(tileLink.getElement) %}
						<div class="js-fitvids">{{ video ? video.html }}</div>
					</div>
				</div>
			</div>
		</div>
		{% js %}
		$("#video-{{ tileLink.getElement.id }}").on("hidden.bs.modal", function (e) {
				$("#video-{{ tileLink.getElement.id }}").find('iframe').attr("src", $("#video-{{ tileLink.getElement.id }}").find('iframe').attr("src"));
		});
		{% endjs %}
	{% endif %}
</div>