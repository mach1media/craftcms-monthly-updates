{##
 # IMPACT REPORT PAGE BUILDER: GENERAL
 #}
<section id="{{ sectionId }}"  class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 col-md-10 col-lg-8">
				{% if block.preEyebrow is defined and block.preEyebrow != '' %}
				<p class="c-report__preeyebrow mb-3"><span>{{ block.preEyebrow | raw }}</span></p>
				{% endif %}
				
				{% if block.eyebrow is defined and block.eyebrow != '' %}
				<p class="c-report__eyebrow mb-3"><span>{{ block.eyebrow }}</span></p>
				{% endif %}

				{% include "_fields/headingBlock" with {'heading': block.headingBlock} %}

				{% if block.description is defined and block.description != '' %}
				<div class="c-wysiwyg">{{ block.description }}</div>
				{% endif %}

				{% if block.signatures is defined and block.signatures | length %}
				<div class="row mt-5">
					{% for row in block.signatures %}
					<div class="col-12 col-md-6 mb-5 mb-md-0">
						{% if row.signature != '' %}
							<p class="c-report__signature mb-0">{{ row.signature | raw }}</p>
						{% endif %}

						{% if row.role != '' %}
							<p class="mb-0">{{ row.role | raw }}</p>
						{% endif %}
						
						{% if row.organization != '' %}
							<p class="mb-0">{{ row.organization | raw }}</p>
						{% endif %}
					</div>
					{% endfor %}
				</div>		
				{% endif %}

				{% if block.button.value | default %}
				<p>{% include "_fields/button" with {'button': block.button, 'color': 'secondary', 'style': block.buttonStyle} %}</p>
				{% endif %}
			</div>
		</div>
	</div>
</section>