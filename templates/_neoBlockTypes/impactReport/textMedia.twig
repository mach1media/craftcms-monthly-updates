{##
 # NEO BLOCK TYPE: IMPACT REPORT PAGE BUILDER: TEXT+MEDIA
 #}
{% set animation = block.animationSettings[0] | default(null) %}
{% set aosDelay  = animation.delay | default(null) %}

{% if block.imageDesktop is defined and block.imageDesktop | length %}
	{% set imgDesktop    = block.imageDesktop.one %}
	{% set imgDesktopSrc = imgDesktop.extension != 'svg' ? imgDesktop.url('responsiveMedium') : imgDesktop.url %}
	{% set imgDesktopAlt = imgDesktop.alt ?: imgDesktop.caption %}
{% endif %}

{% if block.imageMobile is defined and block.imageMobile | length %}
	{% set imgMobile    = block.imageMobile.one %}
	{% set imgMobileSrc = imgMobile.extension != 'svg' ? imgMobile.url('responsiveSmall') : imgMobile.url %}
	{% set imgMobileAlt = imgMobile.alt ?: imgMobile.caption %}
{% endif %}
<section id="section-{{ block.id }}" class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row">
			<div class="col">
				<div class="row justify-content-between">
					{% if block.preEyebrow is defined and block.preEyebrow != '' %}
					<div class="col-12 mb-4">
						<p class="c-report__preeyebrow text-{{ block.textAlignment == 'right' ? 'end' : 'start' }} mb-3"><span>{{ block.preEyebrow | raw }}</span></p>
					</div>
					{% endif %}
					
					<div class="col-12 col-md-6 mb-5 mb-md-0{% if block.imagePositionLR == 'right' %} order-md-2{% endif %}">
						<div{% if animation %}
							class="d-none"
							data-aos="{{ animation.animation }}"
							data-aos-duration="1500"
							data-aos-delay="{{ aosDelay }}"
							data-aos-anchor="#section-{{ block.id }}"{% endif %}>
							{% if block.imageDesktop | length and block.imageMobile | length %}
								<p class="d-md-none"><img class="img-fluid" style="width:100%;" src="{{ imgMobileSrc }}" alt="{{ imgMobileAlt }}" /></p>
								{% if imgDesktop.extension == 'svg' %}
									{{ svg(imgDesktop) | attr({id:'animatedSvg' ~ imgDesktop.id})}}
								{% else %}
									<p class="d-none d-md-block"><img class="img-fluid" style="width:100%;" src="{{ imgDesktopSrc }}" alt="{{ imgDesktopAlt }}" /></p>
								{% endif %}
							{% elseif block.imageDesktop | length %}
								{% if imgDesktop.extension == 'svg' %}
									{{ svg(imgDesktop) | attr({id:'animatedSvg' ~ imgDesktop.id})}}
								{% else %}
									<p><img class="img-fluid" style="width:100%;" src="{{ imgDesktopSrc }}" alt="{{ imgDesktopAlt }}" /></p>
								{% endif %}
							{% elseif block.video | length %}
								{% set embeddedAsset = craft.embeddedAssets.get(block.video.one()) %}
								<div class="js-fitvids">
									{{ embeddedAsset ? embeddedAsset.html }}
								</div>
							{% endif %}
						</div>
					</div>

					{% if animation.staggered | default == 'yes' %}
						{% set aosDelay = aosDelay + 500 %}
					{% endif %}

					<div class="col-12 col-md-5{% if block.imagePositionLR == 'right' %} order-md-1{% endif %}">
						<div{% if animation %}
							class="d-none"
							data-aos="{{ animation.animation }}"
							data-aos-duration="1500"
							data-aos-delay="{{ aosDelay }}"
							data-aos-anchor="#section-{{ block.id }}"{% endif %}>
							{% if block.preheading is defined and block.preheading != '' %}
							<p class="c-report__preheading mb-0">{{ block.preheading | raw }}</p>
							{% endif %}

							{# animated svg heading or static heading #}
							{% if block.image | length %}
								{% set img = block.image.one %}
								{% if img.extension == 'svg' %}
									{{ svg(img) | attr({id:'animatedSvg' ~ img.id})}}
								{% else %}
								<img src="{{ img.url('responsiveMedium') }}" alt="{{ img.alt ?: img.title }}" class="img-fluid">
								{% endif %}
							{% elseif block.heading is defined and block.heading != '' %}
							<h2 class="c-report__heading">{{ block.heading | raw }}</h2>
							{% endif %}

							{% if block.subheading is defined and block.subheading != '' %}
							<p class="c-report__subheading">{{ block.subheading | raw }}</p>
							{% endif %}
							
							{% if block.description is defined and block.description != '' %}
							<div class="c-wysiwyg{% if block.button | length %} mb-4{% endif %}">
								{% apply enkode_emails %}
									{{ block.description }}
								{% endapply %}
							</div>
							{% endif %}

							{% for childBlock in block.children.all() %}
								{% if childBlock.button.value | default %}
									<p class="mt-4">
										{% include "_fields/button" with {
											'button': childBlock.button, 
											'class': 'btn-pill',
											'style': childBlock.buttonStyle
										} %}
									</p>
								{% endif %}
							{% endfor %}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>