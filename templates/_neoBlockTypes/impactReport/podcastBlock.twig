{##
 # NEO BLOCK TYPE: IMPACT REPORT PAGE BUILDER: PODCAST BLOCK
 #}
{% set animation = block.animationSettings[0] %}
{% set aosDelay  = animation.delay %}
<section id="section-{{ block.id }}" class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row">
			<div class="col">
				<div class="row justify-content-between">
					{% if block.preEyebrow is defined and block.preEyebrow != '' %}
					<div class="col-12 mb-4">
						<p class="c-report__preeyebrow text-{{ block.textAlignment == 'right' ? 'end' : 'start' }} mb-3"><span>{{ block.preEyebrow | raw }}</span></p>
					</div>
					{% endif %}
					
					<div class="col-12 col-md-6 mb-5 mb-md-0{% if block.imagePositionLR == 'right' %} order-md-2{% endif %}">
						{% if block.image | length %}
							{% set img = block.image.one %}
							<div class="text-center mb-3{% if animation %} d-none{% endif %}"
								{% if animation %}
									data-aos="{{ animation.animation }}"
									data-aos-duration="1500"
									data-aos-delay="{{ aosDelay }}"
									data-aos-anchor="#section-{{ block.id }}"
								{% endif %}>
								<img class="img-fluid" src="{{ img.url }}" alt="{{ img.alt ?: img.title }}">
							</div>
						{% endif %}

						{% if animation and animation.staggered == 'yes' %}
							{% set aosDelay = aosDelay + 500 %}
						{% endif %}
						
						{% if block.factoidDescriptionBox | length %}
							{% for row in block.factoidDescriptionBox %}
								<div class="d-block w-100 {{ row.backgroundColor }} bg-opacity-25 p-3 p-md-5 mb-3 rounded{% if animation %} d-none{% endif %}"
									{% if animation %}
										data-aos="{{ animation.animation }}"
										data-aos-duration="1500"
										data-aos-delay="{{ aosDelay }}"
										data-aos-anchor="#section-{{ block.id }}"
									{% endif %}>
									{% if row.heading != '' %}
										<h2 class="c-report__heading lh-1 mb-4">{{ row.heading | raw }}</h2>
									{% endif %}

									{% if row.subheading is defined and row.subheading != '' %}
									<p class="c-report__subheading lh-1">{{ row.subheading | raw }}</p>
									{% endif %}
									
									{% if row.description is defined and row.description != '' %}
									<div class="c-wysiwyg u-last-child">
										{{ row.description }}
									</div>
									{% endif %}
								</div>
							{% endfor %}
						{% endif %}

						{% if animation and animation.staggered == 'yes' %}
							{% set aosDelay = aosDelay + 500 %}
						{% endif %}
						
						{# CHILD BLOCKS #}
						{% if block.children | length %}
							<div class="c-podcast__impact-report-block d-block w-100 bg-tertiary bg-opacity-25 p-3 p-xl-5 mb-3 rounded{% if animation %} d-none{% endif %}"
								{% if animation %}
								data-aos="{{ animation.animation }}"
								data-aos-duration="1500"
								data-aos-delay="{{ aosDelay }}"
								data-aos-anchor="#section-{{ block.id }}"{% endif %}>
								<div class="row row-cols-1 row-cols-lg-{{ block.children | length }}">
									{% for childBlock in block.children.all() %}
										{% set img = childBlock.image.one %}
										<div class="col{% if not loop.first %} mt-3 mt-lg-0{% endif %}">
											<div class="c-story-card c-story-card--scalable" style="background:url('{{ img.url }}') center center no-repeat;background-size:cover;">
												<div class="c-story-card__content">
													{% if childBlock.preheading != '' %}
													<p class="u-preheading">
														{% if childBlock.textLink.getLink() %}
															<a href="{{ childBlock.textLink }}" class="stretched-link">{{ childBlock.preheading | raw }}</a>
														{% else %}
															{{ childBlock.preheading | raw }}
														{% endif %}
													</p>
													{% endif %}

													{% if childBlock.heading != '' %}
														<h2 class="c-story-card__heading">{{ childBlock.heading | raw }}</h2>
													{% endif %}

													{% if childBlock.subheading %}
														<p>{{ childBlock.subheading | raw }}</p>
													{% endif %}
												</div>
											</div>
										</div>
									{% endfor %}
								</div>

								{% if block.button.getLink() %}
									<div class="text-center mt-4 px-4 px-lg-5">
										{% set classes = ['btn','btn-pill','btn-lg','btn-outline-secondary','text-primary','bg-white','w-100'] %}
										{{ block.button.getLink({'class':classes|join(' ')}) }}
									</div>
								{% endif %}
							</div>
						{% endif %}
					</div>

					{% if animation and animation.staggered == 'yes' %}
						{% set aosDelay = aosDelay + 500 %}
					{% endif %}

					<div class="col-12 col-md-5{% if block.imagePositionLR == 'right' %} order-md-1{% endif %}">
						<div{% if animation %}
							class="d-none"
							data-aos="fade"
							data-aos-duration="1500"
							data-aos-delay="{{ aosDelay }}"
							data-aos-anchor="#section-{{ block.id }}"{% endif %}>
							{% if block.eyebrow is defined and block.eyebrow != '' %}
							<p class="c-report__eyebrow mb-3"><span>{{ block.eyebrow }}</span></p>
							{% endif %}
							{#
							{% if block.image | length %}
								{% set img = block.image.one %}
								<p class="text-center">
									<img class="img-fluid" src="{{ img.url }}" alt="{{ img.alt ?: img.title }}">
								</p>
							{% endif %}
							#}
							{% if block.heading is defined and block.heading != '' %}
								<h2 class="c-report__heading">{{ block.heading | raw }}</h2>
							{% endif %}
							
							{% if block.description is defined and block.description != '' %}
								<div class="c-wysiwyg{% if block.button | length %} mb-4{% endif %}">
									{% apply enkode_emails %}
										{{ block.description }}
									{% endapply %}
								</div>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>