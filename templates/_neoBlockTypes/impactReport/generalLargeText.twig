{##
 # IMPACT REPORT PAGE BUILDER: GENERAL
 #}
{% set textAlignment = 'text-' ~ block.textAlignment %}
{% if block.textAlignment == 'left' %}
	{% set textAlignment = 'text-start' %}
{% elseif block.textAlignment == 'right' %}
	{% set textAlignment = 'text-end' %}
{% endif %}

{# set text color #}
{% set textColor = '' %}
{% if not block.textColor %}
	{% switch block.backgroundColor %}
		{% case 'bg-primary' %}
			{% set textColor = ' text-white' %}

		{% case 'bg-secondary' %}
			{% set textColor = ' text-white' %}
			
		{% case 'bg-tertiary' %}
			{% set textColor = ' text-white' %}
			
		{% case 'bg-dark' %}
			{% set textColor = ' text-white' %}
			
		{% case 'bg-black' %}
			{% set textColor = ' text-white' %}
			
	{% endswitch %}
{% else %}
	{% set textColor = ' ' ~ block.textColor %}
{% endif %}

<section id="{{ sectionId }}" class="c-block{% if sectionStyleClasses is defined and sectionStyleClasses != '' %} {{ sectionStyleClasses }}{% endif %}">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 col-md-10 col-lg-8 lead">
				{% if block.preEyebrow is defined and block.preEyebrow != '' %}
					<p class="c-report__preeyebrow {{ textAlignment }} mb-3{{ textColor }}"><span>{{ block.preEyebrow | raw }}</span></p>
				{% endif %}
				
				{% if block.eyebrow is defined and block.eyebrow != '' %}
					<p class="c-report__eyebrow {{ textAlignment }} mb-3{{ textColor }}"><span>{{ block.eyebrow }}</span></p>
				{% endif %}
				
				{% include "_fields/headingBlock" with {
					heading: block.headingBlock,
					class: block.textColor
				} %}

				{% if block.description is defined and block.description != '' %}
					<div class="c-wysiwyg {{ textAlignment }}{{ textColor }}">{{ block.description }}</div>
				{% endif %}

				{% if block.signatures is defined and block.signatures | length %}
					<div class="hstack gap-5 justify-content-{{ block.textAlignment }} mt-5 flex-wrap flex-md-nowrap">
						{% for row in block.signatures %}
						<div>
							{% if row.signature != '' %}
								<p class="c-report__signature mb-0">{{ row.signature | raw }}</p>
							{% endif %}

							{% if row.role != '' %}
								<p class="mb-0{{ textColor }}">{{ row.role | raw }}</p>
							{% endif %}
							
							{% if row.organization != '' %}
								<p class="mb-0{{ textColor }}">{{ row.organization | raw }}</p>
							{% endif %}
						</div>
						{% endfor %}
					</div>
				{% endif %}

				{% if block.button.value | default %}
					<p class="mt-4 {{ textAlignment }}">
						{% include "_fields/button" with {
							'button': block.button, 
							'color': 'secondary', 
							'style': block.buttonStyle
						} %}
					</p>
				{% endif %}
			</div>
		</div>
	</div>
</section>