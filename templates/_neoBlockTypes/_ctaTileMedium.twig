{##
 # CTA TILE: Medium
 #}
{% set img          = block.image.one %}
{% set imgSrc       = img.format != 'svg' ? img.url('responsiveMedium') : img.url %}
{% set imgAlt       = img.alt %}
{% set tileLink     = block.tileLink %}
<div class="col-12 col-sm-6">
	<div class="c-tiles__tile c-tiles__tile--featured c-tiles__tile--medium{% if block.stackImageOnMobile%} c-tiles__tile--stacked-mobile{% endif %}">
		<a class="c-tiles__img-link"
			href="{{ tileLink.value }}"
			{% if tileLink.type == 'asset' and tileLink.element.kind | default == 'json' %}
				data-bs-toggle="modal"
				data-bs-target="#video-{{ tileLink.element.id }}"
			{% endif %}
			{% if tileLink.target == '_blank' %}
				target="_blank"
			{% endif %}>
			<img src="{{ imgSrc }}" alt="{{ imgAlt }}" />
		</a>

		<div class="c-tiles__description h-100 d-flex flex-column justify-content-between">
			{% if block.labelCustom != '' %}
				<p class="u-preheading">{{ block.labelCustom }}</p>
			{% elseif block.label == 'loans' %}
				<p class="u-preheading">Loans</p>
			{% elseif block.label == 'grants' %}
				<p class="u-preheading">Grants</p>
			{% elseif block.label == 'investments' %}
				<p class="u-preheading">Investments</p>
			{% elseif block.label == 'area-representatives' %}
				<p class="u-preheading">Area Representatives</p>
			{% elseif block.label == 'philanthropy' %}
				<p class="u-preheading">Philanthropy</p>
			{% elseif block.label == 'leadership-ministry' %}
				<p class="u-preheading">Leadership Ministry</p>
			{% endif %}

			<div>
				{% if block.heading != '' %}
					<h2 class="h4">{{ block.heading }}</h2>
				{% endif %}

				<div class="c-tiles__description-footer">
					<span class="text-white">{{ block.tileLink.label }}</span>
				</div>
			</div>
		</div>
	</div>

	{% if tileLink.type == 'asset' and tileLink.element.kind | default == 'json' %}
		<!-- Modal -->
		<div class="modal fade" id="video-{{ tileLink.element.id }}" tabindex="-1" aria-labelledby="video-{{ tileLink.element.id }}-label" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered modal-xl">
				<div class="modal-content bg-dark">
					<div class="modal-body">
						{% set video = craft.embeddedAssets.get(tileLink.element) %}
						<div class="js-fitvids">{{ video ? video.html }}</div>
					</div>
				</div>
			</div>
		</div>
		{% js %}
		$("#video-{{ tileLink.element.id }}").on("hidden.bs.modal", function (e) {
				$("#video-{{ tileLink.element.id }}").find('iframe').attr("src", $("#video-{{ tileLink.element.id }}").find('iframe').attr("src"));
		});
		{% endjs %}
	{% endif %}
</div>