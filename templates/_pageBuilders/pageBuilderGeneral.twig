{# Eager-load the Neo field #}
{% for block in entry.pageBuilderGeneral %}
	{% do block.useMemoized() %}
{% endfor %}

{# Loop through eager-loaded Neo fields blocks #}
{% for block in entry.pageBuilderGeneral %}
{% if block.level == 1 %}

{# = = = = = = = = = SECTION STYLES = = = = = = = = = = = #}
{% set sectionStyleClasses = [] %}

{% if block.fields.backgroundColor is defined and block.backgroundColor != 'none' %}
	{% set sectionStyleClasses = sectionStyleClasses|merge([block.backgroundColor]) %}
{% endif %}

{% if block.fields.paddingTop is defined and block.paddingTop != '1' %}
	{% set sectionStyleClasses = sectionStyleClasses|merge(['c-block--no-padding-top']) %}
{% endif %}

{% if block.fields.paddingBottom is defined and block.paddingBottom != '1' %}
	{% set sectionStyleClasses = sectionStyleClasses|merge(['c-block--no-padding-bottom']) %}
{% endif %}
{#
{% if block.fields.paddingSides is defined and block.paddingSides == '1' %}
	{% set sectionStyleClasses = sectionStyleClasses|merge(['c-block--guttered']) %}
{% endif %}
#}

{% if block.fields.sectionId is defined and block.sectionId != '' %}
	{% set sectionId = block.sectionId %}
{% else %}
	{% set sectionId = 'section-' ~ block.id %}
{% endif %}

<!-- {{ block.type }}: {{ block.id }} -->
{% include [
		("_neoBlockTypes/" ~ block.type), 
		("_neoBlockTypes/impactReport/" ~ block.type), 
	]
	with {
		'block': block, 
		'sectionStyleClasses': sectionStyleClasses | join(' ')
	}
%}

{% endif %}
{% endfor %}