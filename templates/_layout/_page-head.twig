{##
 # PAGE HEADER AND NAVIGATION MENU
 #}
{% set navNodes   = craft.entries.section('navigationMenu').status(['not','disabled']).all() %}
{% set linkGive   = '#' %}
{% set linkInvest = '#' %}
<a id="top"></a>
<header class="c-header sticky-top" id="header">
	<!-- DESKTOP HEADER -->
	<div class="container-fluid d-none d-xxl-block c-header__desktop">
		<div class="row align-items-center justify-content-end">
			<div class="col d-flex justify-content-end py-3">
				<ul class="nav flex-nowrap">
					<li class="nav-item me-3">
						<a class="nav-link btn btn-sm btn-outline-secondary" href="https://give.texasmethodistfoundation.org/give-to-tmf" target="_blank" rel="noopener">Donate</a>
					</li>

					<li class="nav-item">
						<a class="nav-link btn btn-sm btn-outline-secondary" href="https://onlineportal.texasmethodistfoundation.org/login" target="_blank" rel="noopener">Login</a>
					</li>
				</ul>
			</div>
		</div>
		
		<div class="row align-items-center justify-content-between py-xxl-4 border-top border-secondary">
			<div class="col d-flex align-items-center">
				<a class="c-header__branding" href="{{ siteUrl }}">
					<img src="/dist/img/logo-color.svg" alt="{{ siteName }} home" />
				</a>
			</div>

			<div class="col d-flex justify-content-center">
				<nav class="c-header__nav">
					<ul class="nav flex-nowrap">
						{% for node in navNodes %}
							{% if node.type == 'megaMenu' %}
								<li class="nav-item c-header__mega-toggle">
									<button class="nav-link js-nav-item"
										type="button" 
										id="mega-{{ node.slug }}-tab"
										data-bs-toggle="collapse" 
										data-bs-target="#mega-{{ node.slug }}" 
										aria-expanded="false" 
										aria-controls="mega-{{ node.slug }}">{{ node.title }}</button>
								</li>
							{% elseif node.type == 'dropdown' %}
								<li class="nav-item dropdown">
									{# BOOTSTRAP DROPDOWN BUTTON TOGGLE
									<a class="nav-link dropdown-toggle" 
										href="#" 
										role="button" 
										data-bs-toggle="dropdown"
										aria-expanded="false">
										{{ node.title }}
									</a>
									#}
									{{ node.textLink.getLink({
										class: 'nav-link dropdown-toggle',
										text: node.textLink.getCustomText(node.title)
									}) }}
									<ul class="dropdown-menu">
										{% for dropdownItem in node.dropdownLinks.all() %}
										{% set page = dropdownItem.dropdownLink %}
										<li>
											{{ page.getLink({class: 'dropdown-item'}) }}
										</li>
										{% endfor %}
									</ul>
								</li>
							{% elseif node.type == 'link' %}
								{% set page = node.textLink %}
								<li class="nav-item">
									{{ page.getLink({class: 'nav-link js-nav-item'}) }}
								</li>
							{% endif %}
						{% endfor %}
					</ul>
				</nav>
			</div>

			<div class="col d-flex justify-content-end">
				<nav class="c-header__utility">
					<ul class="nav flex-nowrap">
						<li class="nav-item" role="presentation">
							<button class="nav-link btn btn-text p-0 js-modal-search-toggle" type="button">
								<span class="c-icon c-icon--search"></span>
							</button>
						</li>

						<li class="nav-item">
							<a class="nav-link btn btn-secondary" href="{{ url('investments/investment-inquiry') }}">Invest</a>
						</li>
						
						<li class="nav-item">
							<a class="nav-link btn btn-secondary" href="{{ url('loans/inquiry') }}">Loan Inquiry</a>
						</li>
					</ul>
				</nav>
			</div>
		</div>
	</div>

	<!-- MOBILE HEADER -->
	<div class="continaer-fluid d-xxl-none c-header__mobile">
		<div class="d-flex align-items-center justify-content-between p-1{# border-secondary border-bottom #}">
			<button class="btn btn-text p-0 js-modal-search-toggle" type="button">
				<span class="c-icon c-icon--search"></span>
			</button>

			<nav>
				<ul class="nav">
					<li class="nav-item me-3">
						<a class="nav-link btn btn-sm btn-outline-secondary" href="https://give.texasmethodistfoundation.org/give-to-tmf" target="_blank" rel="noopener">Donate</a>
					</li>

					<li class="nav-item">
						<a class="nav-link btn btn-sm btn-outline-secondary" href="https://onlineportal.texasmethodistfoundation.org/login" target="_blank" rel="noopener">Login</a>
					</li>
				</ul>
			</nav>
		</div>

		<div class="d-flex align-items-center justify-content-between px-1 py-2 border-secondary border-top">
			<a class="c-header__branding" href="{{ siteUrl }}">
				<img src="/dist/img/logo-color.svg" alt="{{ siteName }} home" />
			</a>

			<nav class="c-header__utility d-flex justify-content-end me-3">
				<ul class="nav flex-nowrap">
					<li class="nav-item">
						<a class="nav-link btn btn-secondary" href="{{ url('investments/investment-inquiry') }}">Invest</a>
					</li>
					
					<li class="nav-item">
						<a class="nav-link btn btn-secondary" href="{{ url('loans/inquiry') }}">Loan Inquiry</a>
					</li>
				</ul>
			</nav>

			<button class="btn btn-secondary c-header__menu-toggle"
				id="menu-mobile-label"
				type="button" 
				data-bs-toggle="offcanvas"
				data-bs-target="#menu-mobile"
				aria-controls="menu-mobile"
				aria-label="open/close menu">
				<span class="c-icon c-icon--hamburger-white"></span>
				<span class="c-icon c-icon--close-white d-none"></span>
			</button>
		</div>
	</div>

	{# =========== MEGA MENU PANELS =========== #}
	{% for node in navNodes %}
		{% if node.type == 'megaMenu' %}
		<div id="mega-{{ node.slug }}" class="c-header__mega-menu js-megamenu shadow collapse" aria-labelledby="mega-{{ node.slug }}-tab" data-bs-parent="#header">
			<div class="row gx-0">
				{% if node.megaMenuCtas | length %}
				<div class="col-4 c-header__mega-menu-features">
					{% for block in node.megaMenuCtas.all() %}
						{% if block.type == 'label' %}
							<p class="u-base-font-semibold">{{ block.label | raw }}</p>
						{% elseif block.type == 'cta' %}
							{% set link   = block.ctaLink %}
							{% set img    = block.image.one() %}
							{% set imgSrc = img.url('responsiveSmall') %}
							{% set imgAlt = img.alt %}
							<a class="d-block lh-sm{% if not loop.last%} mb-5{% endif %}" href="{{ link.getIntrinsicUrl() }}">
								<img class="d-block w-100 img-fluid rounded mb-2" src="{{ imgSrc }}" alt="{{ imgAlt }}" />
								{{ link.getText() ?: link.element.title }}
							</a>
						{% endif %}
					{% endfor %}
				</div>
				{% endif %}

				<div class="col-8 p-5">
					<div class="row">
						{% set columns = (node.megaMenuLinks.level(1) | length / 2) | round(0, 'ceil') %}
						{% for column in node.megaMenuLinks.level(1)|batch(columns) %}
						<div class="col-6">
							{% for group in column %}
								{% if group.textLink | length %}
								<p class="h5{% if group.children | length == 0 %} mb-5{% endif %}"><a href="{{ group.textLink.getIntrinsicUrl() }}">{{ group.textLink.getText() }}</a></p>
								{% endif %}
								{% if group.children | length %}
								<ul class="mb-5">
									{% for child in group.children.all() %}
									<li><a href="{{ child.textLink.getIntrinsicUrl() }}{% if child.sectionId != '' %}#{{ child.sectionId }}{% endif %}">{{ child.textLink.getText() }}</a></li>
									{% endfor %}
								</ul>
								{% endif %}
							{% endfor %}
						</div>
						{% endfor %}
					</div>
				</div>
			</div>
		</div>
		{% endif %}
	{% endfor %}
</header>

<!-- MOBILE OFFCANVAS MENU -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="menu-mobile" aria-labelledby="menu-mobile-label">
	<div class="offcanvas-header">
		<a class="c-header__offcanvas-branding" href="{{ siteUrl }}" title="homepage">
			<img src="/dist/img/logo-color.svg" alt="{{ siteName }} home" />
		</a>
		
		<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
	</div>

	<div class="offcanvas-body p-0">
		<!-- faceted nav -->
		<div class="c-header__faceted d-block h-100">
			<ul class="d-flex h-100 flex-column justify-content-start">
				{% for node in navNodes %}
					{% if node.type == 'megaMenu' %}
					<li class="menu-{{ node.slug }}" data-node-type="{{ node.type }}">
						<label for="menu-{{ node.slug }}">{{ node.title }}</label>
						<input type="checkbox" id="menu-{{ node.slug }}" name="menu-{{ node.slug }}" class="c-header__faceted-checkbox" />

						<div class="c-header__faceted-sub">
							<label class="c-header__faceted-sub-toggle" for="menu-{{ node.slug }}">Back</label>
							<ul id="accordion-{{ node.slug }}">
								{% for group in node.megaMenuLinks.level(1) %}
									{% set largeLink = group.textLink %}
									{% if group.children | length %}
										<li>
											<button
												class="c-header__faceted-accordion-toggle"
												type="button" 
												data-bs-toggle="collapse"
												data-bs-target="#accordion-{{ group.id }}"
												aria-expanded="false"
												aria-controls="accordion-{{ group.id }}">{{ largeLink.getText() ?: largeLink.element.title }}</button>
											<div class="collapse" id="accordion-{{ group.id }}" data-bs-parent="#accordion-{{ node.slug }}">
												<ul>
													{% for child in group.children.all() %}
														{% set page = child.textLink %}
														<li><a href="{{ page.getIntrinsicUrl() }}{% if child.sectionId != '' %}#{{ child.sectionId }}{% endif %}">{{ page.getText() ?: child.element.title }}</a></li>
													{% endfor %}
												</ul>
											</div>
										</li>
									{% else %}
										<li><a href="{{ largeLink.getIntrinsicUrl() }}">{{ largeLink.getText() ?: largeLink.element.title }}</a></li>
									{% endif %}
								{% endfor %}
							</ul>
						</div>
					</li>

					{% elseif node.type == 'dropdown' %}
						{% set link = node.textLink %}
						<li class="menu-{{ node.slug }}">
							<div class="c-header__faceted-accordion-toggle d-flex">
								<a class="flex-fill"
									href="{{ link.getIntrinsicUrl() }}">
									{{ link.getText() ?: node.title }}
								</a>
								<button type="button"
									class="btn"
									data-bs-toggle="collapse"
									data-bs-target="#accordion-{{ node.id }}"
									aria-expanded="false"
									aria-controls="accordion-{{ node.id }}">
									<span class="visually-hidden">Toggle Dropdown</span>
								</button>
							</div>
							{#
							<button
								class="c-header__faceted-accordion-toggle"
								type="button" 
								data-bs-toggle="collapse"
								data-bs-target="#accordion-{{ node.id }}"
								aria-expanded="false"
								aria-controls="accordion-{{ node.id }}">{{ node.title }}</button>
							#}
							<div class="collapse" id="accordion-{{ node.id }}" data-bs-parent="#accordion-{{ node.slug }}">
								<ul>
									{% set parentLink = node.linkToPage | length ? node.linkToPage.one : null %}
									{% if parentLink %}
									<li><a href="{{ parentLink.url }}">{{ node.title }}</a></li>
									{% endif %}
									{% for dropdownItem in node.dropdownLinks.all() %}
									{% set page = dropdownItem.dropdownLink %}
									<li><a href="{{ page.getIntrinsicUrl() }}">{{ page.getText() ?: page.element.title }}</a></li>
									{% endfor %}
								</ul>
							</div>
						</li>

					{% elseif node.type == 'link' %}
						{% set page = node.textLink %}
						<li class="menu-{{ node.slug }}"><a href="{{ page.getIntrinsicUrl() }}">{{ page.getText() ?: node.title }}</a></li>

					{% endif %}
				{% endfor %}
			</ul>
		</div>
	</div>
</div>

<!-- SITE SEARCH -->
<div id="search-bar" class="c-search bg-secondary text-white d-flex align-items-center justify-content-between">
	<form action="{{ url('search') }}" method="get" class="c-search__form">
		<div class="input-group">
			<button class="c-search__submit" type="submit" id="modal-search-button" aria-label="search website"></button>
			<input name="q" type="search" class="form-control" placeholder="search our website" aria-label="search website" aria-describedby="modal-search-button">
		</div>
	</form>

	<button type="button" class="btn btn-primary js-modal-search-toggle" aria-label="Close"><span class="visually-hidden-selectable">Close</span></button>
</div>