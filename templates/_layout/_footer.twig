<!-- FOOTER: GLOBAL -->
<footer id="footer" class="c-footer">
	<div class="c-block container">
		<div class="row align-items-lg-end align-items-xxl-start">
			<div class="col-12 col-lg-8 col-xxl-4 mb-3 mb-xxl-0 text-white">
				<h2 class="c-footer__heading mb-4 text-white">
					{{ footer.heading != '' ? footer.heading | raw : 'Join us in a<br />cycle of generosity' | raw }}
				</h2>

				{{ footer.quote }}
			</div>
			
			<div class="col-12 col-sm-8 col-lg-4 col-xxl-2 mb-3 pe-xxl-5">
				<div class="row">
					{% for block in footer.textLinks.all() %}
						{% if block.textLink.getLink() %}
							<div class="col-6 col-xxl-12 p-2">
								{% include "_fields/textLink" with {
									'textLink': block.textLink,
									class: 'btn btn-primary d-block'
								} %}
							</div>
						{% endif %}
					{% endfor %}
				</div>
			</div>
			
			<div class="col-12 col-xxl-6">
				<p class="c-footer__preeyebrow text-start mb-3">
					<span>Legal</span>
				</p>

				<div class="row ">
					<div class="col-12 col-md-4 mb-md-3 col-lg-3">
						<ul class="list-unstyled">
							{% for block in footer.legalLinks.all() %}
								{% if block.textLink.getLink() %}
									<li class="mb-2">
										{% include "_fields/textLink" with {
											'textLink': block.textLink,
											'class': 'link-primary text-decoration-none'
										} %}
									</li>
								{% endif %}
							{% endfor %}
						</ul>
					</div>
					
					<div class="col-12 col-md-8 col-lg-9 text-white">
						{{ footer.description }}
					</div>
				</div>
			</div>
		</div>
	</div>
	
	<div class="container-fluid c-footer__bottom">
		<div class="row align-items-center">
			<div class="col-12 col-md-6 order-md-2 text-center text-md-end mb-2 mb-md-0">
				<p>
					<a class="c-footer__social" href="https://www.facebook.com/txmethodistfdn" target="_blank" rel="noopener" title="Connect with us on Facebook"><img src="/dist/img/icon-facebook-white.svg" alt="Facebook" style="height:1.5rem;width:auto" /></a>
					
					<a class="c-footer__social" href="https://www.instagram.com/texasmethodistfoundation/" target="_blank" rel="noopener" title="Follow us on Instagram"><img src="/dist/img/icon-instagram-white.svg" alt="Instagram" style="height:1.5rem;width:auto" /></a>
					
					<a class="c-footer__social" href="https://twitter.com/TxMethodistFdn" target="_blank" rel="noopener" title="Follow us on X" ><img src="/dist/img/icon-x-twitter.svg" alt="X" style="height:1.25rem;width:auto" /></a>
					
					<a class="c-footer__social" href="https://vimeo.com/texasmethodistfoundation" target="_blank" rel="noopener" title="Watch our video content on Vimeo" ><img src="/dist/img/icon-vimeo.svg" alt="Vimeo" style="height:1.25rem;width:auto" /></a>
					
					<a class="c-footer__social" href="https://www.linkedin.com/company/texasmethodistfoundation/" target="_blank" rel="noopener" title="Connect with us on LinkedIn"><img src="/dist/img/icon-linkedin.svg" alt="LinkedIn" style="height:1.5rem;width:auto" /></a>
				</p>
			</div>
			
			<div class="col-12 col-md-6 order-md-1 text-center text-md-start">
				<p style="font-size:75%;">
					&copy;{{ now|date('Y') == '2022' ? now|date('Y') : '2022-' ~ now|date('Y') }} Texas Methodist Foundation. Designed by <a href="https://studionuma.co" target="_blank" rel="noopener" title="Studio Numa - Jarrett Johnston - Graphic Designer">Numa</a>
				</p>
			</div>
		</div>
	</div>
</footer>